<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Explorar</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.catalog-grid{grid-template-columns:repeat(5,1fr);height:100%;align-content:start}.catalog-grid .live-card .art{aspect-ratio:16/7}.catalog-grid .live-card{min-height:102px}.catalog-grid .card-body{padding:7px}.filters{display:flex;align-items:center;gap:5px}.filters button{height:29px;padding:0 11px}.hero-live{display:flex;flex-direction:column;justify-content:center}.hero-live h2{font-size:23px;margin:3px 0}.hero-live p{max-width:260px;margin:3px 0 9px}.searchbox{margin-left:auto;width:245px}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-1" id="stage"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><section id="heroLive" class="live-panel soft pad hero-live" style="left:43.2%;top:12.0%;width:25.8%;height:22.8%"><span class="live-badge">MELHOR ROTA</span><h2 id="heroTitle">Carregando...</h2><p id="heroDesc" class="live-sub"></p><div><a id="heroPlay" class="live-btn primary">▶ Jogar agora</a></div></section><div style="position:absolute;z-index:15;left:3.8%;top:35.7%;display:flex;gap:5px"><span id="apiStatus" class="status-pill">API ...</span><span id="wasmStatus" class="status-pill">WASM ...</span><span id="agentStatus" class="status-pill">Local Agent ...</span><span id="streamStatus" class="status-pill">Streaming ...</span></div><section class="live-panel clear pad" style="left:3.25%;top:39.5%;width:93.6%;height:6.1%;padding:7px 10px"><div class="filters" id="filters"><button class="live-btn primary" data-filter="all">▦ Todos</button><button class="live-btn" data-filter="wasm">◉ WASM</button><button class="live-btn" data-filter="retro">🎮 Retro</button><button class="live-btn" data-filter="pc">▣ PC</button><button class="live-btn" data-filter="stream">☁ Online</button><input id="search" class="live-input searchbox" placeholder="Buscar jogos, gêneros ou plataformas..."></div></section><section class="live-panel clear pad" style="left:3.15%;top:46.2%;width:93.7%;height:45.4%;padding:10px"><div id="catalogGrid" class="live-grid catalog-grid"><div class="live-empty">Carregando catálogo real…</div></div></section></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const $=SC.$,esc=SC.esc;let games=[],routes=new Map(),filter='all';const caps={wasm:typeof WebAssembly==='object',webgpu:!!navigator.gpu,local_agent:false,remote_stream:false};$('wasmStatus').textContent='WASM · '+(caps.wasm?'ON':'OFF');$('wasmStatus').classList.toggle('ok',caps.wasm);try{const r=await fetch('http://127.0.0.1:47831/health',{cache:'no-store'});caps.local_agent=r.ok}catch{}$('agentStatus').textContent='Local Agent · '+(caps.local_agent?'ON':'OFF');$('agentStatus').classList.toggle('ok',caps.local_agent);try{const s=await SC.json('/streaming/status');caps.remote_stream=!!s.configured}catch{}$('streamStatus').textContent='Streaming · '+(caps.remote_stream?'ON':'fallback');$('streamStatus').classList.toggle('ok',caps.remote_stream);try{const h=await SC.json('/healthz');$('apiStatus').textContent='API · online';$('apiStatus').classList.add('ok')}catch{$('apiStatus').textContent='API · offline';$('apiStatus').classList.add('err')}try{const d=await SC.json('/catalog');games=d.items||[];await Promise.all(games.map(async g=>{try{const r=await fetch(`/api/catalog/${encodeURIComponent(g.id)}/resolve`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(caps)});if(r.ok)routes.set(g.id,(await r.json()).decision)}catch{}}));render();const first=games.find(g=>routes.get(g.id)?.launch_url)||games[0];if(first){$('heroTitle').textContent=first.title;$('heroDesc').textContent=first.description||'';const route=routes.get(first.id);$('heroPlay').textContent=route?.launch_url?'▶ Jogar agora':'Indisponível';$('heroPlay').href=route?.launch_url||'#'}}catch(e){$('catalogGrid').innerHTML='<div class="live-empty">Falha ao carregar catálogo.</div>'}function match(g){const r=routes.get(g.id),q=$('search').value.trim().toLowerCase();if(q&&!(g.title+' '+(g.description||'')).toLowerCase().includes(q))return false;if(filter==='all')return true;if(filter==='wasm')return r?.mode?.includes('wasm')||g.routes?.some(x=>x.mode?.includes('wasm'));if(filter==='retro')return g.category==='retro'||r?.mode==='retro-wasm';if(filter==='pc')return r?.mode==='local-native'||g.category==='pc';if(filter==='stream')return r?.mode==='remote-stream';return true}function render(){const list=games.filter(match);$('catalogGrid').innerHTML=list.length?list.slice(0,15).map((g,i)=>{const r=routes.get(g.id),mode=(r?.mode||g.category||'GAME').toUpperCase();const hue=['#b73417,#2b0707','#173a95,#782bad','#0c6174,#5929a0','#3e3220,#151525'][i%4];return `<a class="live-card" href="${r?.launch_url||'#'}" style="text-decoration:none;color:inherit;${r?.launch_url?'':'opacity:.58'}"><div class="art" style="background:linear-gradient(145deg,${hue})"><span class="live-badge" style="position:absolute;left:7px;top:7px">${esc(mode)}</span></div><div class="card-body"><div class="name">${esc(g.title)}</div><div class="meta">${esc((g.description||'').slice(0,72))}</div></div></a>`}).join(''):'<div class="live-empty">Nenhum jogo neste filtro.</div>'}$('search').oninput=render;$('filters').onclick=e=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('primary',x===b));render()}});</script></body></html>
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · PC Local</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.pc-status{left:79.3%;top:10.3%;width:18.7%;height:48.0%;padding:16px}.pc-status h2{font-size:14px;margin:0 0 12px}.pc-status .label{color:#8395ba;font-size:8px;margin-top:10px}.pc-status .value{font-size:11px;margin-top:2px}.pc-bottom{top:58.7%;height:31.5%;padding:12px}.pc-bottom h2{font-size:13px;margin:0 0 8px}.pc-dev{left:3.2%;width:20.4%}.pc-games{left:24.3%;width:47.2%}.pc-continue{left:72.3%;width:25.5%}.pc-game-grid{grid-template-columns:repeat(5,1fr);height:84%}.pc-game-grid .live-card .art{aspect-ratio:3/4}.continue-list{display:grid;gap:7px}.continue-item{height:68px;background:#081020;border:1px solid #50648d3f;border-radius:9px;padding:8px;display:flex;gap:8px;align-items:center}.continue-art{width:78px;height:52px;background:#15223d;border-radius:6px}.hero-chips{position:absolute;z-index:14;left:4.2%;top:45.3%;display:flex;gap:7px}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-4" id="stage"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><a class="hotspot" style="left:4.2%;top:36.6%;width:11%;height:5.5%" id="heroLaunch" tabindex="0">Iniciar jogo</a><a class="hotspot" style="left:15.8%;top:36.6%;width:13.7%;height:5.5%" data-href="/account/" tabindex="0">Parear dispositivo</a><div class="hero-chips"><span id="agentChip" class="status-pill">Agent · ...</span><span id="osChip" class="status-pill">SO · ...</span><span id="gpuChip" class="status-pill">GPU local · ...</span></div><aside class="live-panel clear pc-status"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Status do Agent</h2><span id="online" class="live-sub">● Offline</span></div><div class="label">Hostname</div><div id="host" class="value">—</div><div class="label">Plataforma</div><div id="platform" class="value">—</div><div class="label">CPU</div><div id="cpu" class="value">—</div><div class="label">Arquitetura</div><div id="arch" class="value">—</div><div class="label">Última sincronização</div><div id="seen" class="value">—</div><a class="live-btn" href="/account/" style="margin-top:14px;width:100%">Exibir detalhes do sistema ›</a></aside><section class="live-panel clear pc-bottom pc-dev"><h2>Dispositivos pareados</h2><div id="devices"><div class="live-empty">Carregando…</div></div><a class="live-btn" href="/account/" style="width:100%;margin-top:8px">＋ Parear novo dispositivo</a></section><section class="live-panel clear pc-bottom pc-games"><div style="display:flex;justify-content:space-between"><h2>Jogos instalados</h2><span class="live-sub">allowlist local</span></div><div id="games" class="live-grid pc-game-grid"><div class="live-empty">Aguardando Local Agent…</div></div></section><section class="live-panel clear pc-bottom pc-continue"><h2>Continuar no PC</h2><div id="continue" class="continue-list"></div></section></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const $=SC.$,esc=SC.esc,agent='http://127.0.0.1:47831';let localGames=[],agentInfo=null,devices=[];async function detect(){try{const [h,c,g]=await Promise.all([fetch(agent+'/health',{cache:'no-store'}).then(r=>{if(!r.ok)throw Error();return r.json()}),fetch(agent+'/capabilities',{cache:'no-store'}).then(r=>r.json()),fetch(agent+'/games',{cache:'no-store'}).then(r=>r.json())]);agentInfo={...h,...c};localGames=g.games||[];$('online').textContent='● Online';$('online').style.color='#39e995';$('host').textContent=h.name||'Este PC';$('platform').textContent=c.os||'—';$('arch').textContent=c.arch||'—';$('cpu').textContent=(c.logical_cpus||'—')+' CPUs lógicas';$('seen').textContent='Agora';$('agentChip').textContent='Agent · online';$('agentChip').classList.add('ok');$('osChip').textContent=c.os||'Sistema';$('gpuChip').textContent='GPU local · detectada';$('gpuChip').classList.add('ok');renderGames()}catch{$('agentChip').textContent='Agent · offline';$('agentChip').classList.add('err');$('osChip').textContent='Local Agent não detectado';$('gpuChip').textContent='GPU local · aguardando';renderGames()}}async function account(){try{const me=await SC.me();if(!me)return;const d=await SC.json('/devices');devices=(d.items||[]).filter(x=>!x.revoked);$('devices').innerHTML=devices.length?devices.slice(0,2).map(x=>`<div class="live-row"><span class="live-dot"></span><div><b>${esc(x.name)}</b><div class="live-sub">${esc(x.os)} · ${esc(x.arch)}</div></div></div>`).join(''):'<div class="live-sub">Nenhum PC pareado.</div>';try{const c=await SC.json('/activity/continue');const items=(c.items||[]).filter(x=>x.mode==='local-native').slice(0,3);$('continue').innerHTML=items.length?items.map(x=>`<a class="continue-item" href="${esc(x.launch_url||'/pc/?game='+encodeURIComponent(x.game_key))}" style="color:inherit;text-decoration:none"><div class="continue-art"></div><div style="min-width:0"><b style="font-size:10px">${esc(x.title)}</b><div class="live-sub">Última sessão · ${esc(x.platform_id||'PC')}</div><div class="live-progress" style="margin-top:7px"><span style="width:35%"></span></div></div></a>`).join(''):'<div class="live-sub">Nenhuma sessão PC recente.</div>'}catch{}}catch{}}function renderGames(){if(!localGames.length){$('games').innerHTML='<div class="live-empty">Abra o Local Agent e cadastre jogos na allowlist.</div>';return}$('games').innerHTML=localGames.slice(0,5).map((g,i)=>`<article class="live-card"><div class="art" style="background:linear-gradient(145deg,${['#f2cc17,#1f1d26','#775e15,#15172a','#244c86,#282143','#9c1c16,#1b0b0b','#4290b9,#092346'][i%5]})"><span class="live-badge" style="position:absolute;left:6px;top:6px">LOCAL-NATIVE</span></div><div class="body"><div class="name">${esc(g.name)}</div><button class="live-btn primary" style="width:100%;margin-top:6px" onclick="launch('${g.id}')">▶ Jogar</button></div></article>`).join('');const first=localGames[0];if(first)$('heroLaunch').onclick=()=>launch(first.id)}window.launch=async id=>{const me=await SC.me();if(!me){SC.toast('Entre na conta para gerar o ticket.','err');return}if(!devices.length){SC.toast('Pareie este PC na página Conta.','err');return}try{SC.toast('Gerando ticket seguro…');const t=await SC.json(`/devices/${devices[0].id}/launch-ticket`,{method:'POST',body:JSON.stringify({game_id:id})});const r=await fetch(`${agent}/launch/${encodeURIComponent(id)}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ticket:t.ticket})});if(!r.ok)throw Error(await r.text());SC.toast('Jogo iniciado na GPU local.','ok')}catch(e){SC.toast(e.message,'err')}};await Promise.allSettled([detect(),account()])});</script></body></html>
/* StorCloud Pixel Replica — approved 1672×941 mockups are the visual source of truth. */
:root{--ink:#f7f8ff;--muted:#9eabc8;--panel:#070d1cf5;--panel2:#0a1226f2;--line:#6681bd42;--blue:#4b70ff;--violet:#972dff;--green:#39e995;--red:#ff526b;--yellow:#ffbd32}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#02040b;color:var(--ink);font-family:Inter,"Segoe UI",system-ui,sans-serif;overflow:hidden}button,input,select{font:inherit}.pixel-root{position:fixed;inset:0;display:grid;place-items:center;background:#02040b}.pixel-root:before{content:"";position:absolute;inset:-5vw;background-image:url('/assets/mockups/atlas.avif');background-size:cover;background-position:center;filter:blur(42px) brightness(.32) saturate(1.2);opacity:.92;transform:scale(1.08)}.pixel-stage{position:relative;width:min(100vw,calc(100vh * 1672 / 941));aspect-ratio:1672/941;overflow:hidden;background-image:url('/assets/mockups/atlas.avif');background-repeat:no-repeat;background-size:100% 800%;background-position-x:0;box-shadow:0 0 90px #000b;isolation:isolate}.frame-0{background-position-y:0}.frame-1{background-position-y:14.285714%}.frame-2{background-position-y:28.571429%}.frame-3{background-position-y:42.857143%}.frame-4{background-position-y:57.142857%}.frame-5{background-position-y:71.428571%}.frame-6{background-position-y:85.714286%}.frame-7{background-position-y:100%}.hotspot{position:absolute;z-index:10;display:block;background:transparent;border:0;color:transparent;text-decoration:none;cursor:pointer}.hotspot:focus-visible{outline:2px solid #b27cff;outline-offset:-2px;border-radius:10px;box-shadow:0 0 24px #773cff99}.live-profile{position:absolute;z-index:14;top:1.25%;right:2.35%;width:15.6%;height:5.6%;border:1px solid #647bb83d;border-radius:12px;background:linear-gradient(135deg,#0b1226fa,#07101ffa);display:flex;align-items:center;gap:8px;padding:0 10px;box-shadow:0 8px 28px #0008;color:white;cursor:pointer}.live-avatar{width:34px;height:34px;border-radius:50%;border:1px solid #9370ff;background:radial-gradient(circle at 35% 28%,#eb3dd6,#4538c5 45%,#071124 72%);flex:none}.live-profile .who{min-width:0;font-size:10px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.live-profile .who small{display:block;color:#41e69a;font-size:7px;font-weight:600;margin-top:1px}.live-panel{position:absolute;z-index:12;background:linear-gradient(145deg,rgba(5,11,25,.98),rgba(8,15,34,.98));border:1px solid rgba(105,130,190,.26);border-radius:13px;box-shadow:0 12px 32px #0008;overflow:hidden}.live-panel.soft{background:rgba(5,10,24,.93);backdrop-filter:blur(10px)}.live-panel.pad{padding:12px}.live-panel.clear{background:linear-gradient(145deg,rgba(5,11,25,.985),rgba(8,15,34,.985))}.live-title{margin:0;color:white;font-size:13px;font-weight:850}.live-sub{color:#9eabc8;font-size:8px;line-height:1.45}.live-row{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid rgba(120,145,200,.12);font-size:9px}.live-row:last-child{border-bottom:0}.live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 9px #39e99588;flex:none}.live-badge{display:inline-flex;align-items:center;height:19px;padding:0 7px;border-radius:999px;background:#6825c84d;border:1px solid #9a55ff55;color:#caa6ff;font-size:7px;font-weight:800;text-transform:uppercase}.live-btn{height:31px;padding:0 12px;border-radius:9px;border:1px solid #7187bf4d;background:#0c1630;color:#fff;font-size:9px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:5px}.live-btn.primary{border:0;background:linear-gradient(90deg,#416cff,#a124ff);box-shadow:0 0 19px #7a39ff55}.live-btn.red{color:#ff7889;border-color:#a23a4c66}.live-btn:focus-visible,.live-input:focus-visible,.live-select:focus-visible{outline:2px solid #9d69ff;outline-offset:2px}.live-input,.live-select{height:32px;width:100%;border:1px solid #5d70a13f;border-radius:8px;background:#070d1d;color:white;padding:0 9px;font-size:9px}.live-grid{display:grid;gap:8px}.live-card{background:#081020;border:1px solid #536aa23b;border-radius:10px;overflow:hidden;min-width:0}.live-card .art{position:relative;background:linear-gradient(145deg,#16347f,#6a2bae,#bd2b68);overflow:hidden}.live-card .art img{width:100%;height:100%;object-fit:cover;display:block}.live-card .body{padding:8px}.live-card .name{font-weight:800;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.live-card .meta{font-size:7px;color:#9eabc8;margin-top:3px}.status-pill{height:26px;border-radius:9px;background:#06101f;border:1px solid #4d668f50;color:#95a5c5;padding:0 10px;display:inline-flex;align-items:center;font-size:8px;font-weight:700}.status-pill.ok{color:#45e99d;border-color:#287f6266}.status-pill.err{color:#ff7b8c;border-color:#a63d5066}.live-table{width:100%;border-collapse:collapse;font-size:8px}.live-table th{color:#8796b6;font-weight:650;text-align:left;padding:6px;border-bottom:1px solid #44577950}.live-table td{padding:6px;border-bottom:1px solid #44577926}.live-empty{height:100%;display:grid;place-items:center;text-align:center;color:#91a0bd;font-size:10px;padding:16px}.live-progress{height:5px;border-radius:999px;background:#17213b;overflow:hidden}.live-progress>span{display:block;height:100%;background:linear-gradient(90deg,#4a6eff,#a020ff)}.toast{position:absolute;z-index:30;left:50%;top:9%;transform:translateX(-50%);min-width:270px;max-width:55%;padding:9px 12px;border-radius:9px;background:#08101ef2;border:1px solid #536aa24d;color:#dce5ff;font-size:9px;box-shadow:0 14px 35px #0009;display:none}.toast.show{display:block}.toast.err{color:#ff9cab;border-color:#b8445c66}.toast.ok{color:#7cf0b7;border-color:#2b9d7066}.modal-backdrop{position:absolute;z-index:40;inset:0;background:#02050bd9;display:grid;place-items:center}.auth-modal{width:43%;max-height:78%;overflow:auto;border:1px solid #667db65c;border-radius:18px;background:linear-gradient(145deg,#091127,#050a17);padding:20px;box-shadow:0 30px 90px #000}.auth-modal h1{font-size:24px;margin:0 0 5px}.auth-tabs{display:flex;gap:6px;margin:13px 0}.auth-tabs button{flex:1}.auth-form{display:grid;gap:8px}.auth-form label{font-size:8px;color:#9daccc}.auth-form .two{display:grid;grid-template-columns:1fr 1fr;gap:8px}.hidden{display:none!important}@media(max-aspect-ratio:1.2){.pixel-stage{width:100vw;height:auto}.live-profile{width:23%}.auth-modal{width:72%}}
(()=>{const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));window.SC={esc,$,toast(text,kind=''){let t=$('toast');if(!t)return;t.className='toast show '+kind;t.textContent=text;clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.classList.remove('show'),4200)},async json(path,opt={}){const r=await fetch('/api'+path,{credentials:'same-origin',...opt,headers:{...(opt.body instanceof FormData?{}:{'Content-Type':'application/json'}),...(opt.headers||{})}});let d=null;try{d=await r.json()}catch{}if(!r.ok){let detail=d?.detail;if(Array.isArray(detail))detail=detail.map(x=>x?.msg||x?.message||JSON.stringify(x)).join(' · ');else if(detail&&typeof detail==='object')detail=detail.message||JSON.stringify(detail);throw Error(detail||`HTTP ${r.status}`)}return d},async me(){try{return (await this.json('/auth/me')).user}catch{return null}},fmtSeconds(s){s=Number(s||0);const h=Math.floor(s/3600),m=Math.floor((s%3600)/60);return h?`${h}h ${m}m`:`${m}m`},setProfile(user){const p=$('liveProfile');if(!p)return;if(!user){p.innerHTML='<div class="live-avatar"></div><div class="who">Entrar<small>Conta StorCloud</small></div>';p.onclick=()=>location.href='/account/';return}p.innerHTML=`<div class="live-avatar"></div><div class="who">${esc(user.username)}${user.role==='admin'?' · Admin':''}<small>● Online</small></div>`;p.onclick=()=>location.href='/account/'},bindHotspots(){document.querySelectorAll('[data-href]').forEach(el=>{el.addEventListener('click',()=>location.href=el.dataset.href);el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();location.href=el.dataset.href}})});document.addEventListener('keydown',e=>{if(e.key==='Escape'||e.key==='Backspace'){const tag=document.activeElement?.tagName;if(tag==='INPUT'||tag==='TEXTAREA')return;e.preventDefault();history.back()}})},async boot(){this.bindHotspots();this.setProfile(await this.me())}};document.addEventListener('DOMContentLoaded',()=>SC.boot())})();
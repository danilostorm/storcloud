<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Conquistas</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.ach-summary{left:62.2%;top:8.4%;width:34.2%;height:25.2%;padding:12px}.ach-summary .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.ach-stat{padding:8px;border-right:1px solid #53668d35}.ach-stat:last-child{border:0}.ach-stat b{font-size:18px}.ach-stat small{display:block;font-size:7px;color:#9ca9c2;margin-top:3px}.player-strip{left:4.1%;top:29.6%;width:45.4%;height:10.2%;padding:10px;display:grid;grid-template-columns:1.4fr .7fr 1.2fr;align-items:center;gap:10px}.player-box{display:flex;align-items:center;gap:9px}.big-level{font-size:25px;font-weight:850}.ach-region{position:absolute;z-index:12;left:4.05%;width:92.1%}.ach-region h2{font-size:12px;margin:0 0 7px}.ach-cards{display:grid;gap:8px}.recent{top:41.6%;height:15.5%}.recent .ach-cards{grid-template-columns:repeat(6,1fr)}.rare{top:59.3%;height:15.4%}.rare .ach-cards{grid-template-columns:repeat(4,1fr)}.progress-zone{top:77%;height:13.5%}.progress-zone .ach-cards{grid-template-columns:repeat(5,1fr)}.ach-card{height:112px;background:#081020f7;border:1px solid #536a9a42;border-radius:10px;padding:8px;display:flex;gap:8px;overflow:hidden}.ach-icon{width:58px;height:58px;border-radius:9px;background:radial-gradient(circle,#9137ff,#1b265a 65%,#07101f);display:grid;place-items:center;font-size:27px;flex:none}.ach-card b{font-size:10px}.ach-card p{font-size:7px;color:#9da9c2;margin:3px 0}.ach-card .date{font-size:6.5px;color:#71809d;margin-top:6px}.locked-tag{display:inline-flex;margin-top:5px;padding:3px 6px;border-radius:999px;border:1px solid #7560b844;color:#bca8ef;font-size:6px}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-5"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><section class="live-panel clear ach-summary"><h2 class="live-title">Resumo de Conquistas</h2><div id="summaryStats" class="stats" style="margin-top:8px"></div><h2 class="live-title" style="margin-top:12px">Estatísticas da Jornada</h2><div id="journeyStats" class="stats" style="margin-top:6px"></div></section><section class="live-panel clear player-strip"><div class="player-box"><div class="live-avatar" style="width:55px;height:55px"></div><div><b id="playerName" style="font-size:14px">Jogador</b><div class="live-sub" style="color:#39e995">● Online</div></div></div><div><div class="live-sub">Nível StorCloud</div><div id="level" class="big-level">1</div></div><div><div class="live-sub">Tempo para próximo nível</div><div class="live-progress" style="margin:8px 0"><span id="xpBar" style="width:0"></span></div><div id="xpText" class="live-sub">0h / 5h</div></div></section><section class="ach-region recent"><h2>🏆 Conquistas Recentes</h2><div id="recentCards" class="ach-cards"></div></section><section class="ach-region rare"><h2>◇ Conquistas Bloqueadas</h2><div id="rareCards" class="ach-cards"></div></section><section class="ach-region progress-zone"><h2>↻ Próximas metas</h2><div id="progressCards" class="ach-cards"></div></section></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const $=SC.$,esc=SC.esc;const me=await SC.me();if(!me){SC.toast('Entre na sua conta para ver conquistas.','err');setTimeout(()=>location.href='/account/',1200);return}$('playerName').textContent=me.username;try{const [d,a]=await Promise.all([SC.json('/achievements'),SC.json('/activity/summary').catch(()=>({total_hours:0,distinct_games:0,total_sessions:0}))]);const pct=d.total?Math.round(d.unlocked/d.total*100):0;const hours=Number(a.total_hours||0),level=Math.max(1,Math.floor(hours/5)+1),within=hours%5;$('level').textContent=level;$('xpBar').style.width=Math.min(100,(within/5)*100)+'%';$('xpText').textContent=`${within.toFixed(1)}h / 5h`;$('summaryStats').innerHTML=`<div class="ach-stat"><b>${d.unlocked}</b><small>Conquistas totais</small></div><div class="ach-stat"><b>${Math.max(0,d.total-d.unlocked)}</b><small>Bloqueadas</small></div><div class="ach-stat"><b>${pct}%</b><small>Conclusão geral</small></div><div class="ach-stat"><b>${hours}h</b><small>Horas jogadas</small></div>`;$('journeyStats').innerHTML=`<div class="ach-stat"><b>${a.distinct_games||0}</b><small>Jogos</small></div><div class="ach-stat"><b>${a.total_sessions||0}</b><small>Sessões</small></div><div class="ach-stat"><b>${level}</b><small>Nível StorCloud</small></div><div class="ach-stat"><b>${d.total}</b><small>Metas</small></div>`;const unlocked=(d.items||[]).filter(x=>x.unlocked),locked=(d.items||[]).filter(x=>!x.unlocked);function card(x,upcoming=false){return `<article class="ach-card"><div class="ach-icon">${esc(x.icon||'🏆')}</div><div style="min-width:0"><b>${esc(x.title)}</b><p>${esc(x.description)}</p>${upcoming?'<span class="locked-tag">META PENDENTE</span>':`<div class="date">${x.unlocked_at?'Desbloqueada em '+new Date(x.unlocked_at).toLocaleDateString():'Ainda bloqueada'}</div>`}</div></article>`}$('recentCards').innerHTML=(unlocked.slice(0,6).map(x=>card(x)).join('')||'<div class="live-empty">Nenhuma conquista desbloqueada ainda.</div>');$('rareCards').innerHTML=(locked.slice(0,4).map(x=>card(x)).join('')||'<div class="live-empty">Tudo desbloqueado.</div>');$('progressCards').innerHTML=(locked.slice(0,5).map(x=>card(x,true)).join('')||'<div class="live-empty">Sem metas pendentes.</div>')}catch(e){SC.toast(e.message,'err')}});</script></body></html>
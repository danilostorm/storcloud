<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Player Retro</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.player-stage{position:absolute;z-index:12;left:4.45%;top:17.2%;width:62.25%;height:58.7%;background:#02040a;border:1px solid #536aa455;border-radius:16px;overflow:hidden;display:grid;place-items:center}.player-stage canvas{max-width:100%;max-height:100%;width:auto!important;height:auto!important;outline:none}.player-empty{color:#8e9bb8;font-size:11px;text-align:center}.player-empty b{display:block;color:#fff;font-size:18px;margin-bottom:6px}.player-side{left:68.0%;top:18.0%;width:26.9%;height:65.8%;padding:18px}.player-side .game-head{display:flex;gap:10px;align-items:center;margin:8px 0 15px}.player-side .thumb{width:54px;height:72px;border-radius:7px;background:#141c30;overflow:hidden;flex:none}.player-side .thumb img{width:100%;height:100%;object-fit:cover}.player-menu{display:grid;gap:3px;margin-top:12px}.player-menu button{height:39px;border:0;border-bottom:1px solid #43516e33;background:transparent;color:#d7e0f4;text-align:left;padding:0 12px;border-radius:8px;font-size:10px;cursor:pointer}.player-menu button.primary{background:linear-gradient(90deg,#416cff,#9b25ff);color:white;border:0}.player-menu button.danger{color:#ff5e6d}.player-menu button:disabled{opacity:.4}.quick-slots{left:3.5%;top:76.7%;width:63.1%;height:13.6%;padding:10px;display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.quick-slot{border:1px solid #4d618f4a;border-radius:9px;background:#081020;padding:7px;display:flex;gap:7px;align-items:center;min-width:0}.quick-slot .mini{width:50px;height:46px;border-radius:6px;background:#121a2d;overflow:hidden;flex:none}.quick-slot .mini img{width:100%;height:100%;object-fit:cover}.quick-slot b{font-size:9px}.top-metrics{position:absolute;z-index:13;left:4.45%;top:10.3%;width:51%;height:5.4%;display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.metric{background:#071022f4;border:1px solid #52699745;border-radius:9px;padding:7px 11px;font-size:8px;color:#9faece}.metric b{display:block;color:#45ec96;font-size:10px;margin-top:2px}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-3" id="stage"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><div class="top-metrics"><div class="metric">FPS<b id="fps">60.0 FPS</b></div><div class="metric">Sincronização<b id="sync">Cloud pronto</b></div><div class="metric">Controle<b id="pad">Detectando</b></div><div class="metric">Nuvem<b id="cloud">Online</b></div></div><section id="playerStage" class="player-stage"><div id="empty" class="player-empty"><b>Nenhum jogo carregado</b>Abra um título da Biblioteca Retro.</div><canvas id="gameCanvas" tabindex="0"></canvas></section><section class="live-panel clear player-side"><div class="live-sub" style="color:#b56fff;font-weight:800">JOGO ATUAL</div><div class="game-head"><div id="gameThumb" class="thumb"></div><div><h2 id="gameTitle" class="live-title" style="font-size:17px">—</h2><div id="gamePlatform" class="live-badge" style="margin-top:7px">RETRO</div></div></div><div id="slotSummary" class="live-panel pad" style="position:static;margin:8px 0 12px"><div class="live-sub">SLOT ATUAL</div><div style="margin-top:6px;font-size:9px">Cloud save automático</div></div><div class="player-menu"><button id="continueBtn" class="primary">▶ Continuar</button><button id="saveBtn">▣ Salvar estado</button><button id="loadBtn">▧ Carregar estado</button><button id="rewindBtn" disabled>↶ Rewind</button><button id="fullscreenBtn">⛶ Tela cheia</button><button id="exitBtn" class="danger">⏻ Sair do jogo</button></div></section><section id="quickSlots" class="live-panel clear quick-slots"></section></div></div><script src="/assets/pixel-shell.js"></script><script type="module">import{Nostalgist}from'https://esm.sh/nostalgist@0.21.1';const $=SC.$,esc=SC.esc;let emulator=null,rom=null,platform=null,playSessionId=null,heartbeat=null;const romId=new URLSearchParams(location.search).get('rom');async function boot(){document.getElementById('pad').textContent='getGamepads'in navigator?'Conectado/Pronto':'Não detectado';const me=await SC.me();document.getElementById('cloud').textContent=me?'Online':'Sem login';if(!romId){document.getElementById('continueBtn').textContent='Abrir biblioteca';document.getElementById('continueBtn').onclick=()=>location.href='/library/';renderSlots();return}try{const [lib,plats]=await Promise.all([SC.json('/library/roms'),SC.json('/retro/platforms')]);rom=(lib.items||[]).find(x=>x.id===romId);if(!rom)throw Error('Jogo não encontrado na sua biblioteca.');platform=(plats.items||[]).find(x=>x.id===rom.platform_id);if(!platform)throw Error('Plataforma não suportada.');$('gameTitle').textContent=rom.title;$('gamePlatform').textContent=platform.short||platform.name;$('gameThumb').innerHTML=rom.cover_url?`<img src="${esc(rom.cover_url)}">`:'';$('continueBtn').textContent='▶ Jogar';$('continueBtn').onclick=start;renderSlots()}catch(e){SC.toast(e.message,'err')}}async function startActivity(){await endActivity();try{const r=await fetch('/api/activity/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:'retro-wasm',game_key:`rom-${rom.id}`,title:rom.title,platform_id:platform.id})});if(r.ok){playSessionId=(await r.json()).session.id;heartbeat=setInterval(()=>{if(playSessionId)fetch(`/api/activity/${playSessionId}/heartbeat`,{method:'POST'}).catch(()=>{})},30000)}}catch{}}async function endActivity(){if(heartbeat){clearInterval(heartbeat);heartbeat=null}const id=playSessionId;playSessionId=null;if(id)try{await fetch(`/api/activity/${id}/end`,{method:'POST',keepalive:true})}catch{}}async function start(){if(!rom||!platform)return;try{$('continueBtn').disabled=true;SC.toast(`Preparando ${platform.short}…`);if(emulator)try{emulator.exit()}catch{}$('empty').style.display='none';emulator=await Nostalgist.prepare({element:$('gameCanvas'),core:platform.core,rom:{fileName:rom.file_name,fileContent:rom.file_url},cache:{core:true,rom:false,bios:true,shader:true},retroarchConfig:{rewind_enable:true,savestate_thumbnail_enable:true,video_smooth:false,menu_driver:'rgui'}});await emulator.start();fetch(`/api/library/roms/${encodeURIComponent(rom.id)}/played`,{method:'POST'}).catch(()=>{});await startActivity();$('continueBtn').textContent='▶ Continuar';$('continueBtn').disabled=false;$('continueBtn').onclick=()=>{try{emulator.resume()}catch{}};SC.toast('Emulação local iniciada.','ok');$('gameCanvas').focus()}catch(e){$('empty').style.display='block';$('continueBtn').disabled=false;SC.toast('Falha ao iniciar: '+(e.message||e),'err')}}async function stateBlob(){const r=await emulator.saveState(),s=r?.state||r;return s instanceof Blob?s:new Blob([s])}$('saveBtn').onclick=async()=>{if(!emulator)return;try{const b=await stateBlob(),f=new FormData();f.append('file',b,rom.title+'.state');const r=await fetch(`/api/saves/${encodeURIComponent('rom-'+rom.id)}/auto`,{method:'POST',body:f});if(!r.ok)throw Error(r.status===401?'Entre na conta para cloud save.':'Falha no cloud save');SC.toast('Estado salvo na nuvem.','ok');renderSlots()}catch(e){SC.toast(e.message,'err')}};$('loadBtn').onclick=async()=>{if(!emulator)return;try{const r=await fetch(`/api/saves/${encodeURIComponent('rom-'+rom.id)}/auto`);if(!r.ok)throw Error(r.status===404?'Nenhum save encontrado.':'Falha ao carregar');await emulator.loadState(await r.blob());SC.toast('Estado carregado.','ok')}catch(e){SC.toast(e.message,'err')}};$('fullscreenBtn').onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await $('playerStage').requestFullscreen()}catch{}};$('exitBtn').onclick=async()=>{await endActivity();try{emulator?.exit()}catch{}emulator=null;location.href='/library/'};async function renderSlots(){let saves=[];try{saves=(await SC.json('/saves')).items||[]}catch{}const mine=rom?saves.filter(x=>x.game_key===`rom-${rom.id}`):[];$('quickSlots').innerHTML=mine.length?mine.slice(0,4).map((s,i)=>`<div class="quick-slot"><div class="mini">${rom?.background_url?`<img src="${esc(rom.background_url)}">`:''}</div><div><b>${i+1} · ${esc(s.slot)}</b><div class="live-sub">${new Date(s.updated_at).toLocaleString()}</div></div></div>`).join('')+'<div class="quick-slot"><div><b>＋ Novo slot</b><div class="live-sub">Use Salvar estado</div></div></div>':'<div class="quick-slot"><div><b>Slot automático</b><div class="live-sub">Nenhum save ainda</div></div></div>'}window.addEventListener('pagehide',()=>{if(playSessionId)fetch(`/api/activity/${playSessionId}/end`,{method:'POST',keepalive:true}).catch(()=>{})});boot();</script></body></html>
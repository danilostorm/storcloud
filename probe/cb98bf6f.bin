<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Conta</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.account-summary-live{left:42.25%;top:13.1%;width:54.6%;height:18.6%;padding:15px;display:grid;grid-template-columns:1.25fr repeat(4,.72fr);gap:8px;align-items:center}.profile-main{display:flex;align-items:center;gap:12px;padding-right:12px;border-right:1px solid #53658b44}.profile-main .live-avatar{width:66px;height:66px}.profile-main b{font-size:19px}.sum-stat{text-align:center}.sum-stat b{display:block;font-size:21px}.sum-stat small{display:block;color:#9caac5;font-size:8px;margin-top:4px}.acc-panel{padding:15px}.acc-profile{left:4.1%;top:35.0%;width:30.2%;height:27.7%}.acc-devices{left:35.35%;top:35.0%;width:29.1%;height:27.7%}.acc-saves{left:65.55%;top:35.0%;width:30.9%;height:27.7%}.acc-library{left:4.1%;top:64.5%;width:30.2%;height:25.1%}.acc-security{left:35.35%;top:64.5%;width:29.1%;height:25.1%}.acc-admin{left:65.55%;top:64.5%;width:30.9%;height:25.1%}.acc-panel h2{font-size:14px;margin:0 0 8px}.acc-panel .section-head{display:flex;align-items:center;justify-content:space-between}.cover-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;height:105px}.cover-strip .mini-cover{border-radius:6px;background:#15213a;overflow:hidden}.cover-strip img{width:100%;height:100%;object-fit:cover}.security-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #53658b30;font-size:9px}.security-row:last-child{border:0}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-6" id="stage"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><section id="summary" class="live-panel clear account-summary-live"></section><section class="live-panel clear acc-panel acc-profile"><h2>Perfil</h2><p class="live-sub">Suas informações de conta e preferências.</p><div id="profileInfo"></div><button id="logout" class="live-btn red" style="width:100%;margin-top:9px">Sair da conta</button></section><section class="live-panel clear acc-panel acc-devices"><div class="section-head"><h2>Dispositivos pareados</h2><a href="/pc/" class="live-sub">Ver todos</a></div><div id="deviceList"></div><button id="pairPc" class="live-btn" style="width:100%;margin-top:8px">▣ Gerenciar dispositivos</button></section><section class="live-panel clear acc-panel acc-saves"><div class="section-head"><h2>Cloud saves</h2><span class="live-sub">sincronizados</span></div><div id="saveList"></div><a href="/library/" class="live-btn" style="width:100%;margin-top:8px">☁ Abrir biblioteca</a></section><section class="live-panel clear acc-panel acc-library"><div class="section-head"><h2>Minha biblioteca</h2><a href="/library/" class="live-sub">Ver biblioteca</a></div><div id="coverStrip" class="cover-strip"></div><a href="/library/" class="live-btn" style="width:100%;margin-top:9px">▣ Abrir biblioteca</a></section><section class="live-panel clear acc-panel acc-security"><h2>Segurança</h2><p class="live-sub">Credenciais e proteção da conta.</p><div id="securityInfo"></div></section><section id="adminPanel" class="live-panel clear acc-panel acc-admin"><h2>Acesso administrativo</h2><p id="adminText" class="live-sub"></p><div id="adminInfo"></div><a id="adminLink" href="/admin/" class="live-btn primary" style="width:100%;margin-top:10px">◈ Abrir painel Admin</a></section><div id="authModal" class="modal-backdrop hidden"><div class="auth-modal"><h1>StorCloud Play</h1><p class="live-sub">Entre ou crie sua conta para sincronizar biblioteca, saves e dispositivos.</p><div class="auth-tabs"><button id="showLogin" class="live-btn primary">Entrar</button><button id="showRegister" class="live-btn">Criar conta</button></div><div id="loginForm" class="auth-form"><label>Usuário<input id="loginUser" class="live-input" autocomplete="username"></label><label>Senha<input id="loginPass" class="live-input" type="password" autocomplete="current-password"></label><button id="loginBtn" class="live-btn primary">Entrar</button></div><div id="registerForm" class="auth-form hidden"><label>Usuário<input id="regUser" class="live-input"></label><label>E-mail (opcional)<input id="regEmail" class="live-input" type="email"></label><div class="two"><label>Senha<input id="regPass" class="live-input" type="password"></label><label>Confirmar senha<input id="regPass2" class="live-input" type="password"></label></div><label id="setupLabel" class="hidden">Setup token da VM<input id="setupToken" class="live-input"></label><button id="registerBtn" class="live-btn primary">Criar conta</button></div></div></div></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const $=SC.$,esc=SC.esc;let me=await SC.me(),setup=null;if(!me){$('authModal').classList.remove('hidden');try{setup=await SC.json('/setup/status');$('setupLabel').classList.toggle('hidden',!!setup.initialized)}catch{}bindAuth();return}await render();function bindAuth(){$('showLogin').onclick=()=>{$('loginForm').classList.remove('hidden');$('registerForm').classList.add('hidden');$('showLogin').classList.add('primary');$('showRegister').classList.remove('primary')};$('showRegister').onclick=()=>{$('loginForm').classList.add('hidden');$('registerForm').classList.remove('hidden');$('showRegister').classList.add('primary');$('showLogin').classList.remove('primary')};$('loginBtn').onclick=async()=>{try{await SC.json('/auth/login',{method:'POST',body:JSON.stringify({username:$('loginUser').value,password:$('loginPass').value})});location.reload()}catch(e){SC.toast(e.message,'err')}};$('registerBtn').onclick=async()=>{if($('regPass').value.length<10){SC.toast('A senha precisa ter pelo menos 10 caracteres.','err');return}if($('regPass').value!==$('regPass2').value){SC.toast('As senhas não são iguais.','err');return}try{await SC.json('/auth/register',{method:'POST',body:JSON.stringify({username:$('regUser').value,email:$('regEmail').value||null,password:$('regPass').value,setup_token:$('setupToken').value||null})});location.reload()}catch(e){SC.toast(e.message,'err')}}}async function render(){const [dev,saves,lib,activity]=await Promise.all([SC.json('/devices').catch(()=>({items:[]})),SC.json('/saves').catch(()=>({items:[]})),SC.json('/library/roms').catch(()=>({items:[]})),SC.json('/activity/summary').catch(()=>({total_hours:0}))]);const devices=(dev.items||[]).filter(x=>!x.revoked),ss=saves.items||[],roms=lib.items||[];$('summary').innerHTML=`<div class="profile-main"><div class="live-avatar"></div><div><b>${esc(me.username)}</b><div style="margin-top:6px"><span class="live-badge">${esc(me.role.toUpperCase())}</span></div><div class="live-sub" style="color:#39e995;margin-top:6px">● Online agora</div></div></div><div class="sum-stat"><b>${roms.length}</b><small>ROMs na biblioteca</small></div><div class="sum-stat"><b>${ss.length}</b><small>Cloud saves</small></div><div class="sum-stat"><b>${activity.total_hours||0}h</b><small>Tempo de jogo</small></div><div class="sum-stat"><b>${devices.length}</b><small>Dispositivos</small></div>`;$('profileInfo').innerHTML=`<div class="security-row"><span>Usuário</span><b>${esc(me.username)}</b></div><div class="security-row"><span>E-mail</span><b>${esc(me.email||'Não informado')}</b></div><div class="security-row"><span>Função</span><b>${esc(me.role)}</b></div><div class="security-row"><span>ID de membro</span><b>${esc(String(me.id))}</b></div>`;$('deviceList').innerHTML=devices.length?devices.slice(0,3).map(x=>`<div class="live-row"><span class="live-dot"></span><div><b>${esc(x.name)}</b><div class="live-sub">${esc(x.os)} · ${esc(x.arch)}</div></div><span style="margin-left:auto;color:#39e995;font-size:8px">Ativo</span></div>`).join(''):'<div class="live-empty">Nenhum PC pareado.</div>';$('saveList').innerHTML=ss.length?ss.slice(0,3).map(x=>`<div class="live-row"><div><b>${esc(x.game_key)}</b><div class="live-sub">slot ${esc(x.slot)} · ${new Date(x.updated_at).toLocaleString()}</div></div><span style="margin-left:auto">${(x.size_bytes/1024).toFixed(0)} KB</span></div>`).join(''):'<div class="live-empty">Nenhum cloud save.</div>';$('coverStrip').innerHTML=roms.length?roms.slice(0,5).map(r=>`<a class="mini-cover" href="/retro/?rom=${r.id}">${r.cover_url?`<img src="${esc(r.cover_url)}">`:''}</a>`).join(''):'<div class="live-empty" style="grid-column:1/-1">Biblioteca vazia.</div>';$('securityInfo').innerHTML=`<div class="security-row"><span>Senha</span><b>••••••••••</b></div><div class="security-row"><span>E-mail</span><b>${esc(me.email||'não configurado')}</b></div><div class="security-row"><span>Sessão</span><b style="color:#39e995">Ativa</b></div>`;if(me.role==='admin'){$('adminText').textContent='Você possui privilégios administrativos nesta instância.';$('adminInfo').innerHTML='<div class="security-row"><span>Função atual</span><b>Administrador</b></div><div class="security-row"><span>Painel administrativo</span><b style="color:#39e995">Acesso liberado</b></div>'}else{$('adminText').textContent='Conta de jogador padrão.';$('adminInfo').innerHTML='<div class="security-row"><span>Função atual</span><b>Usuário</b></div>';$('adminLink').classList.add('hidden');try{const s=await SC.json('/setup/admin-status');if(s.can_claim){$('adminInfo').innerHTML+='<div class="security-row"><span>Instância</span><b style="color:#ffbd32">sem admin</b></div>';SC.toast('Esta instância ainda não tem administrador. Use o setup token em Conta para reivindicar.')}}catch{}}}$('logout').onclick=async()=>{await SC.json('/auth/logout',{method:'POST',body:'{}'});location.reload()};$('pairPc').onclick=()=>location.href='/pc/'} });</script></body></html>
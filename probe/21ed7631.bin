<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud Play</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.home-greeting{position:absolute;z-index:12;left:4.7%;top:12.2%;width:36.6%;height:23.5%;background:linear-gradient(90deg,#050914 0,#050914f4 82%,transparent);padding:8px 0}.home-greeting .kicker{font-size:8px;letter-spacing:.18em;font-weight:850;color:#b9c9ff}.home-greeting h1{font-size:38px;line-height:1.03;letter-spacing:-.04em;margin:10px 0 9px;max-width:560px}.home-greeting h1 span{background:linear-gradient(90deg,#b030ff,#4286ff);-webkit-background-clip:text;background-clip:text;color:transparent}.home-greeting p{font-size:11px;line-height:1.5;color:#c5cee2;max-width:500px;margin:0}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-0" id="stage"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile" aria-label="Conta"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.2%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:28%;top:1.4%;width:6.4%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.2%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.4%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.5%;top:1.4%;width:7.5%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><section class="home-greeting"><div class="kicker">STORCLOUD · LOCAL FIRST GAMING</div><h1>Bem-vindo de volta,<br><span id="greetingName">jogador!</span></h1><p>Grandes jogos, em qualquer lugar. Sua biblioteca, seus dispositivos, seus saves e conquistas em uma única central.</p></section><a class="hotspot" id="playNow" style="left:5.3%;top:37.5%;width:11.8%;height:5.8%" tabindex="0">Jogar agora</a><a class="hotspot" style="left:17.3%;top:37.5%;width:10.6%;height:5.8%" data-href="/catalog/" tabindex="0">Explorar</a><div id="apiPill" class="status-pill" style="position:absolute;z-index:16;left:5.4%;top:45.5%;width:6.8%">API · ...</div><div id="wasmPill" class="status-pill" style="position:absolute;z-index:16;left:12.8%;top:45.5%;width:8.2%">WASM · ...</div><div id="gpuPill" class="status-pill" style="position:absolute;z-index:16;left:21.4%;top:45.5%;width:9.4%">WebGPU · ...</div><a class="hotspot game-hot" data-game="doom-wasm" style="left:5.2%;top:59.3%;width:21.4%;height:30.7%" tabindex="0">Doom</a><a class="hotspot game-hot" data-game="retro-library" style="left:27.0%;top:59.3%;width:21.4%;height:30.7%" tabindex="0">Retro</a><a class="hotspot game-hot" data-game="pc-local-library" style="left:48.8%;top:59.3%;width:21.4%;height:30.7%" tabindex="0">PC</a><a class="hotspot game-hot" data-game="quake-wasm" style="left:70.6%;top:59.3%;width:21.5%;height:30.7%" tabindex="0">Quake</a><a class="hotspot" style="left:85.4%;top:52.6%;width:6.5%;height:4%" data-href="/catalog/" tabindex="0">Ver tudo</a></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const me=await SC.me();document.getElementById('greetingName').textContent=(me?.username||'jogador')+'!';const caps={wasm:typeof WebAssembly==='object',webgpu:!!navigator.gpu,local_agent:false,remote_stream:false};document.getElementById('wasmPill').textContent='WASM · '+(caps.wasm?'pronto':'indisponível');document.getElementById('wasmPill').classList.toggle('ok',caps.wasm);document.getElementById('gpuPill').textContent='WebGPU · '+(caps.webgpu?'pronto':'WebGL');try{const h=await fetch('/api/healthz',{cache:'no-store'});if(!h.ok)throw Error();document.getElementById('apiPill').textContent='API · online';document.getElementById('apiPill').classList.add('ok')}catch{document.getElementById('apiPill').textContent='API · offline';document.getElementById('apiPill').classList.add('err')}try{const c=await SC.json('/catalog');const decisions=new Map();await Promise.all((c.items||[]).map(async g=>{try{const r=await fetch(`/api/catalog/${encodeURIComponent(g.id)}/resolve`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(caps)});if(r.ok)decisions.set(g.id,(await r.json()).decision)}catch{}}));document.querySelectorAll('.game-hot').forEach(a=>{const d=decisions.get(a.dataset.game);if(d?.launch_url){a.dataset.href=d.launch_url}else{a.style.cursor='default'}});let first=null;if(me){try{const cont=await SC.json('/activity/continue');first=(cont.items||[]).find(x=>x.launch_url)}catch{}}first=first||[...decisions.values()].find(x=>x?.launch_url);const p=document.getElementById('playNow');if(first?.launch_url){p.dataset.href=first.launch_url;p.onclick=()=>location.href=first.launch_url}else{p.onclick=()=>location.href='/catalog/'}}catch{document.getElementById('playNow').onclick=()=>location.href='/catalog/'}});</script></body></html>
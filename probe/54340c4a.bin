<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Admin</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.admin-metrics{position:absolute;z-index:12;left:5%;top:28.2%;width:91.9%;height:12.4%;display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.admin-metric{background:#071021f6;border:1px solid #536a9a48;border-radius:10px;padding:13px}.admin-metric span{display:block;font-size:8px;color:#a1afd0;text-transform:uppercase}.admin-metric b{display:block;font-size:20px;margin:7px 0 2px}.admin-box{position:absolute;z-index:12;top:42.2%;height:32.8%;padding:12px}.admin-box h2{font-size:12px;margin:0 0 9px;color:#9ec8ff}.services{left:5%;width:21.9%}.activity{left:27.7%;width:21.6%}.usersbox{left:50%;width:26.7%}.actionsbox{left:77.4%;width:19.4%}.quick-action{height:39px;border:1px solid #4d638f42;border-radius:8px;background:#081020;margin-bottom:5px;padding:0 10px;display:flex;align-items:center;justify-content:space-between;color:white;text-decoration:none;font-size:9px}.bottom-box{position:absolute;z-index:12;top:77.4%;height:12.3%;padding:12px}.storage{left:5%;width:44.4%}.backup{left:50%;width:24%}.system{left:74.8%;width:22.1%}.storagebar{height:11px;border-radius:999px;background:#1a2744;overflow:hidden;margin:10px 0}.storagebar span{display:block;height:100%;background:linear-gradient(90deg,#7c32ff,#4d73ff);width:40%}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-7"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><a class="hotspot" style="left:52.8%;top:1.4%;width:5.7%;height:5.7%" data-href="/admin/" tabindex="0">Admin</a><section id="metrics" class="admin-metrics"></section><section class="live-panel clear admin-box services"><h2>SERVIÇOS</h2><div id="services"></div></section><section class="live-panel clear admin-box activity"><h2>ATIVIDADE RECENTE</h2><div id="activity"></div></section><section class="live-panel clear admin-box usersbox"><h2>USUÁRIOS RECENTES</h2><div id="users"></div></section><section class="live-panel clear admin-box actionsbox"><h2>AÇÕES RÁPIDAS</h2><a class="quick-action" href="/account/">Adicionar/gerenciar usuário <span>›</span></a><a class="quick-action" href="/library/">Adicionar ROMs <span>›</span></a><a class="quick-action" href="/stream/">Configurar streaming <span>›</span></a><a class="quick-action" href="/account/">Gerenciar dispositivos <span>›</span></a><a class="quick-action" href="/admin/">Atualizar painel <span>↻</span></a></section><section class="live-panel clear bottom-box storage"><h2 class="live-title">USO DE ARMAZENAMENTO</h2><div id="storageText" style="font-size:16px;font-weight:800;margin-top:5px">Calculando por catálogo…</div><div class="storagebar"><span id="storageBar"></span></div><div id="storageMeta" class="live-sub"></div></section><section class="live-panel clear bottom-box backup"><h2 class="live-title">BACKUPS</h2><div class="live-row"><span>Backup do StorCloud</span><b style="margin-left:auto">scripts/backup.sh</b></div><div class="live-sub">Banco + saves + ROMs + mídia</div></section><section class="live-panel clear bottom-box system"><h2 class="live-title">SISTEMA</h2><div id="systemInfo" class="live-row"></div></section></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const $=SC.$,esc=SC.esc,fmt=SC.fmtSeconds;const me=await SC.me();if(!me||me.role!=='admin'){SC.toast('Acesso de administrador necessário.','err');setTimeout(()=>location.href='/account/',1200);return}try{const [ov,u,a,h,catalog,stream]=await Promise.all([SC.json('/admin/overview'),SC.json('/admin/users/detail'),SC.json('/admin/activity'),SC.json('/healthz'),SC.json('/catalog').catch(()=>({count:0,items:[]})),SC.json('/streaming/status').catch(()=>({configured:false}))]);const metrics=[['Usuários',ov.users??0],['ROMs',ov.roms??0],['Cloud saves',ov.saves??'—'],['Jogos',catalog.count??catalog.items?.length??0],['Dispositivos',ov.devices??0],['Horas',(ov.play_hours??0)+'h']];$('metrics').innerHTML=metrics.map(x=>`<article class="admin-metric"><span>${x[0]}</span><b>${x[1]}</b><small class="live-sub">dados atuais</small></article>`).join('');$('services').innerHTML=`<div class="live-row"><span class="live-dot"></span><b>API</b><span style="margin-left:auto;color:#39e995">Online</span></div><div class="live-row"><span class="live-dot"></span><b>DB</b><span style="margin-left:auto;color:#39e995">Online</span></div><div class="live-row"><span class="live-dot"></span><b>Scanner</b><span style="margin-left:auto;color:#39e995">Pronto</span></div><div class="live-row"><span class="live-dot" style="background:${stream.configured?'#39e995':'#ff526b'}"></span><b>Streaming</b><span style="margin-left:auto;color:${stream.configured?'#39e995':'#ff526b'}">${stream.configured?'Online':'Offline'}</span></div>`;$('activity').innerHTML=(a.items||[]).slice(0,6).map(x=>`<div class="live-row"><div><b>${esc(x.username)}</b> <span class="live-sub">${esc(x.title)}</span><div class="live-sub">${esc(x.mode)} · ${fmt(x.duration_seconds)}</div></div></div>`).join('')||'<div class="live-empty">Sem atividade.</div>';$('users').innerHTML=(u.items||[]).slice(0,6).map(x=>`<div class="live-row"><div class="live-avatar" style="width:26px;height:26px"></div><div><b>${esc(x.username)}</b><div class="live-sub">${esc(x.role)} · ${x.roms} ROMs · ${x.devices} PCs</div></div><span style="margin-left:auto;color:${x.active?'#39e995':'#ff526b'}">${x.active?'Online/Ativo':'Bloqueado'}</span></div>`).join('');const totalRomBytes=(u.items||[]).reduce((s,x)=>s+Number(x.rom_bytes||0),0);$('storageText').textContent=totalRomBytes?`${(totalRomBytes/1073741824).toFixed(2)} GB em ROMs`:`${ov.roms??0} ROMs armazenadas`;$('storageMeta').textContent=`Saves e mídia incluídos nos backups da instância.`;$('storageBar').style.width=Math.min(95,Math.max(8,(ov.roms||0)/10))+'%';$('systemInfo').innerHTML=`<div><span class="live-sub">Versão</span><b style="display:block">v${esc(h.version||'—')}</b></div><div style="margin-left:auto"><span class="live-sub">Ambiente</span><b style="display:block">Produção</b></div>`}catch(e){SC.toast(e.message,'err')}});</script></body></html>
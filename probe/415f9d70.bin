<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Retro</title><link rel="stylesheet" href="/assets/pixel-shell.css"><style>.retro-side button{width:100%;height:43px;display:flex;align-items:center;justify-content:space-between;background:transparent;border:0;color:#d9e1f4;padding:0 12px;border-radius:9px;font-size:10px;cursor:pointer}.retro-side button.active{background:linear-gradient(90deg,#416cff,#9b25ff);color:white}.retro-grid{grid-template-columns:repeat(8,1fr);height:100%;align-content:start}.retro-grid .live-card .art{aspect-ratio:3/4}.retro-grid .live-card .body{padding:6px}.selected-cover{position:absolute;z-index:13;left:20.7%;top:12.7%;width:12.1%;height:31.8%;border-radius:8px;overflow:hidden;background:#080e1d;box-shadow:0 15px 34px #000b}.selected-cover img{width:100%;height:100%;object-fit:cover}.selected-info{left:34.9%;top:13.3%;width:29.2%;height:27.2%;padding:16px;background:linear-gradient(90deg,#050914fa,#050914d9 70%,transparent)}.selected-info h2{font-size:25px;margin:3px 0 8px}.selected-bg{position:absolute;z-index:3;left:46%;top:8%;width:50%;height:39%;overflow:hidden}.selected-bg img{width:100%;height:100%;object-fit:cover;opacity:.9;mask-image:linear-gradient(90deg,transparent 0,#000 20%,#000 100%)}.selected-bg:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#050914 0,transparent 35%),linear-gradient(0deg,#050914 0,transparent 45%)}.retro-tools{display:flex;align-items:center;gap:7px}.retro-tools .live-input{width:31%}.retro-tools .spacer{flex:1}</style></head><body><div class="pixel-root"><div class="pixel-stage frame-2" id="stage"><div id="toast" class="toast"></div><button id="liveProfile" class="live-profile"></button><a class="hotspot" style="left:17%;top:1.4%;width:5.8%;height:5.7%" data-href="/" tabindex="0">Início</a><a class="hotspot" style="left:23.1%;top:1.4%;width:4.8%;height:5.7%" data-href="/catalog/" tabindex="0">Jogos</a><a class="hotspot" style="left:27.8%;top:1.4%;width:6.5%;height:5.7%" data-href="/catalog/" tabindex="0">Explorar</a><a class="hotspot" style="left:34.1%;top:1.4%;width:5.2%;height:5.7%" data-href="/library/" tabindex="0">Retro</a><a class="hotspot" style="left:39.3%;top:1.4%;width:6%;height:5.7%" data-href="/pc/" tabindex="0">PC Local</a><a class="hotspot" style="left:45.4%;top:1.4%;width:7.4%;height:5.7%" data-href="/achievements/" tabindex="0">Conquistas</a><aside class="live-panel clear pad retro-side" style="left:2.3%;top:14.4%;width:16.2%;height:59%"><div id="platformList"></div></aside><aside class="live-panel clear pad" style="left:2.3%;top:75%;width:16.2%;height:13.8%"><div id="retroStats"></div></aside><div id="selectedBg" class="selected-bg"></div><div id="selectedCover" class="selected-cover"><div class="live-empty">Sem capa</div></div><section id="selectedInfo" class="live-panel clear selected-info"><span class="live-badge" id="selectedPlatform">RETRO</span><h2 id="selectedTitle">Sua biblioteca</h2><p id="selectedMeta" class="live-sub">Escolha um jogo para ver detalhes.</p><div style="display:flex;gap:7px;margin-top:12px"><a id="selectedPlay" class="live-btn primary">▶ Jogar</a><button id="selectedFav" class="live-btn">♡ Favoritar</button><button id="selectedScan" class="live-btn">⌗ Escanear capas</button></div></section><section class="live-panel clear pad" style="left:20.2%;top:48.5%;width:76.4%;height:6.1%;padding:7px 10px"><div class="retro-tools"><input id="search" class="live-input" placeholder="Buscar jogos..."><span class="spacer"></span><button id="scanAll" class="live-btn">◉ Scan global</button><button id="addRom" class="live-btn primary">＋ Adicionar ROM</button><button id="favOnly" class="live-btn">♡ Favoritos</button></div></section><section class="live-panel clear pad" style="left:20.2%;top:55.2%;width:76.4%;height:35.7%;padding:9px"><div id="romGrid" class="live-grid retro-grid"><div class="live-empty">Carregando coleção…</div></div></section><input id="romFile" type="file" hidden><input id="coverFile" type="file" accept="image/*" hidden><div id="uploadModal" class="modal-backdrop hidden"><div class="auth-modal"><h1>Adicionar ROM</h1><p class="live-sub">A ROM fica privada na sua conta.</p><div class="auth-form"><label>Título (opcional)<input id="uploadTitle" class="live-input"></label><label>Plataforma<select id="uploadPlatform" class="live-select"></select></label><label>Arquivo<input id="uploadFile" class="live-input" type="file"></label><div style="display:flex;gap:7px;justify-content:flex-end"><button id="cancelUpload" class="live-btn">Cancelar</button><button id="confirmUpload" class="live-btn primary">Enviar</button></div></div></div></div></div></div><script src="/assets/pixel-shell.js"></script><script>document.addEventListener('DOMContentLoaded',async()=>{const $=SC.$,esc=SC.esc;let roms=[],platforms=[],filter='',favOnly=false,selected=null;try{const me=await SC.me();if(!me){SC.toast('Entre na sua conta para acessar a biblioteca.','err');setTimeout(()=>location.href='/account/',1200);return}platforms=(await SC.json('/retro/platforms')).items||[];$('uploadPlatform').innerHTML=platforms.map(p=>`<option value="${p.id}">${esc(p.short)} · ${esc(p.name)}</option>`).join('');await load()}catch(e){SC.toast(e.message,'err')}async function load(){const d=await SC.json('/library/roms');roms=d.items||[];renderSide();renderGrid();select(selected&&roms.find(r=>r.id===selected.id)||roms[0]||null);$('retroStats').innerHTML=`<div class="live-row"><span>▣ Consoles detectados</span><b style="margin-left:auto">${new Set(roms.map(r=>r.platform_id)).size}/${platforms.length}</b></div><div class="live-row"><span>▧ Covers encontradas</span><b style="margin-left:auto;color:#55d8ff">${roms.filter(r=>r.cover_url).length}</b></div><div class="live-row"><span>☁ Cloud saves</span><b style="margin-left:auto;color:#3ae597">Ativo</b></div>`}function renderSide(){const counts={};roms.forEach(r=>counts[r.platform_id]=(counts[r.platform_id]||0)+1);$('platformList').innerHTML=`<button class="${filter===''?'active':''}" data-p=""><span>▣ Todos</span><b>${roms.length}</b></button><button data-fav="1" class="${favOnly?'active':''}"><span>♥ Favoritos</span><b>${roms.filter(r=>r.favorite).length}</b></button>`+platforms.map(p=>`<button class="${filter===p.id?'active':''}" data-p="${p.id}"><span>${esc(p.short)}</span><b>${counts[p.id]||0}</b></button>`).join('');$('platformList').onclick=e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.fav){favOnly=!favOnly}else{filter=b.dataset.p??'';favOnly=false}renderSide();renderGrid()}}function renderGrid(){const q=$('search').value.trim().toLowerCase(),list=roms.filter(r=>(!filter||r.platform_id===filter)&&(!favOnly||r.favorite)&&(!q||r.title.toLowerCase().includes(q)));$('romGrid').innerHTML=list.length?list.slice(0,16).map(r=>`<article class="live-card" tabindex="0" data-id="${r.id}"><div class="art">${r.cover_url?`<img src="${esc(r.cover_url)}" loading="lazy">`:`<div class="live-empty">${esc(r.platform_id.toUpperCase())}</div>`}</div><div class="body"><div class="name">${esc(r.title)}</div><div class="meta">${esc(r.platform_id.toUpperCase())} · ${(r.size_bytes/1048576).toFixed(1)} MB</div></div></article>`).join(''):'<div class="live-empty">Nenhuma ROM neste filtro.<br>Use “Adicionar ROM”.</div>';document.querySelectorAll('[data-id]').forEach(c=>{c.onclick=()=>select(roms.find(r=>r.id===c.dataset.id));c.onkeydown=e=>{if(e.key==='Enter')c.click()}})}function select(r){selected=r;if(!r){$('selectedTitle').textContent='Sua biblioteca';$('selectedMeta').textContent='Adicione uma ROM para começar.';$('selectedCover').innerHTML='<div class="live-empty">Sem jogo</div>';$('selectedBg').innerHTML='';$('selectedPlay').removeAttribute('href');return}$('selectedTitle').textContent=r.title;$('selectedPlatform').textContent=r.platform_id.toUpperCase();$('selectedMeta').textContent=`${(r.size_bytes/1048576).toFixed(2)} MB · ${r.favorite?'Favorito · ':''}${r.metadata_source||'biblioteca privada'}`;$('selectedCover').innerHTML=r.cover_url?`<img src="${esc(r.cover_url)}">`:'<div class="live-empty">Sem capa</div>';$('selectedBg').innerHTML=r.background_url?`<img src="${esc(r.background_url)}">`:'';$('selectedPlay').href=`/retro/?rom=${r.id}`;$('selectedFav').textContent=r.favorite?'♥ Favorito':'♡ Favoritar'}$('selectedFav').onclick=async()=>{if(!selected)return;await SC.json(`/library/roms/${selected.id}/favorite?value=${!selected.favorite}`,{method:'PUT'});await load()};$('selectedScan').onclick=async()=>{if(!selected)return;SC.toast('Procurando box art e screenshot…');try{await SC.json(`/library/roms/${selected.id}/scan`,{method:'POST'});await load();SC.toast('Scan concluído.','ok')}catch(e){SC.toast(e.message,'err')}};$('scanAll').onclick=async()=>{SC.toast('Escaneando coleção…');try{const q=await SC.json('/library/scan',{method:'POST'});let n=0;for(const x of q.items||[]){try{await SC.json(`/library/roms/${x.id}/scan`,{method:'POST'});n++}catch{}}await load();SC.toast(`Scan concluído em ${n} jogos.`,'ok')}catch(e){SC.toast(e.message,'err')}};$('search').oninput=renderGrid;$('favOnly').onclick=()=>{favOnly=!favOnly;renderSide();renderGrid()};$('addRom').onclick=()=>$('uploadModal').classList.remove('hidden');$('cancelUpload').onclick=()=>$('uploadModal').classList.add('hidden');$('confirmUpload').onclick=async()=>{const f=$('uploadFile').files?.[0],p=$('uploadPlatform').value;if(!f||!p){SC.toast('Selecione plataforma e arquivo.','err');return}const form=new FormData();form.append('platform_id',p);form.append('title',$('uploadTitle').value);form.append('file',f,f.name);try{SC.toast('Enviando ROM…');const r=await fetch('/api/library/roms',{method:'POST',body:form});const d=await r.json();if(!r.ok)throw Error(typeof d.detail==='string'?d.detail:'Falha no upload');$('uploadModal').classList.add('hidden');try{await fetch(d.auto_scan_url,{method:'POST'})}catch{}await load();SC.toast('ROM adicionada.','ok')}catch(e){SC.toast(e.message,'err')}}});</script></body></html>
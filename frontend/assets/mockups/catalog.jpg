(()=>{const W=1672,H=941,$=id=>document.getElementById(id);window.SC={W,H,$,esc:s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),detail:d=>{if(!d)return'';if(typeof d==='string')return d;if(Array.isArray(d))return d.map(window.SC.detail).filter(Boolean).join(' · ');if(typeof d==='object')return d.msg||window.SC.detail(d.detail)||JSON.stringify(d);return String(d)},api:async(path,opt={})=>{const headers={...(opt.body instanceof FormData?{}:{'Content-Type':'application/json'}),...(opt.headers||{})};const r=await fetch('/api'+path,{...opt,headers});let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(window.SC.detail(d.detail)||`HTTP ${r.status}`);return d},note:(text,cls='')=>{let e=$('live-message');if(!e){e=document.createElement('div');e.id='live-message';e.className='live-message';document.querySelector('.pixel-stage')?.appendChild(e)}e.textContent=text;e.className='live-message show '+cls;clearTimeout(window.__scnote);window.__scnote=setTimeout(()=>e.classList.remove('show'),3500)},me:null};function fit(){const s=Math.min(innerWidth/W,innerHeight/H);document.querySelector('.pixel-stage')?.setAttribute('style',`transform:translate(-50%,-50%) scale(${s})`)}addEventListener('resize',fit,{passive:true});fit();async function user(){try{const d=await window.SC.api('/auth/me');window.SC.me=d.user;document.querySelectorAll('.live-user').forEach(e=>e.textContent=d.user.username+(d.user.role==='admin'?' · Admin':''));document.querySelectorAll('[data-admin-only]').forEach(e=>e.classList.toggle('hidden',d.user.role!=='admin'))}catch{document.querySelectorAll('.live-user').forEach(e=>e.textContent='Entrar')}}user();})();

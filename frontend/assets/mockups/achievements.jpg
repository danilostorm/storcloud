<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Retro Player</title><link rel="stylesheet" href="/assets/pixel.css"></head><body><div class="pixel-shell"><div class="ambient plate-3"></div><div class="pixel-stage"><div class="pixel-plate plate-3"></div><a class="hot nav-brand" href="/" aria-label="StorCloud Play"></a><a class="hot nav-home" href="/" aria-label="Início"></a><a class="hot nav-games" href="/catalog/" aria-label="Jogos"></a><a class="hot nav-explore" href="/catalog/" aria-label="Explorar"></a><a class="hot nav-retro" href="/library/" aria-label="Retro"></a><a class="hot nav-pc" href="/pc/" aria-label="PC Local"></a><a class="hot nav-ach" href="/achievements/" aria-label="Conquistas"></a><a class="hot nav-search" href="/catalog/" aria-label="Buscar"></a><a class="hot nav-user" href="/account/" aria-label="Conta"></a><div class="live-user">Conta</div><div class="retro-top-status live-mask"><span class="status-pill ok">60 FPS</span><span id="retro-platform" class="status-pill">Plataforma —</span><span id="retro-sync" class="status-pill">Cloud save</span><span id="retro-control" class="status-pill">Controle</span></div><section class="retro-game"><div id="empty" class="retro-empty">Abra um jogo pela Biblioteca Retro ou selecione uma ROM local.</div><canvas id="gameCanvas" tabindex="0"></canvas></section><aside class="live-mask retro-menu scroll"><div class="live-kicker">JOGO ATUAL</div><h2 id="gameTitle">Nenhum jogo</h2><p id="gameMeta" class="live-sub">Aguardando seleção.</p><button id="play" class="live-btn primary" disabled>▶ Iniciar jogo</button><button id="resume" class="live-btn" disabled>▶ Continuar</button><button id="save" class="live-btn" disabled>▧ Salvar estado</button><button id="loadState" class="live-btn" disabled>▣ Carregar estado</button><button id="exportState" class="live-btn" disabled>⇩ Exportar state</button><button id="pause" class="live-btn" disabled>Ⅱ Pausar</button><button id="fullscreen" class="live-btn">⛶ Tela cheia</button><button id="exit" class="live-btn danger" disabled>○ Sair do jogo</button><div style="margin-top:12px" class="live-kicker">ROM LOCAL</div><input id="rom" type="file" class="live-input" style="padding-top:7px;width:100%;height:40px"><select id="platform" class="live-select" style="width:100%;margin-top:5px"><option value="">Detectar plataforma</option></select></aside><section class="live-mask retro-bottom"><div class="live-kicker">SESSÃO / SAVES</div><div id="retro-session" class="live-muted" style="margin-top:6px;font-size:9px">Nenhuma sessão ativa.</div></section><input id="stateFile" type="file" hidden></div></div><script src="/assets/pixel.js"></script><script type="module">import { Nostalgist } from 'https://esm.sh/nostalgist@0.21.1';const {api,$}=SC;let localFile=null,emulator=null,platforms=[],libraryRom=null,session=null,hb=null;const ext=n=>(n.split('.').pop()||'').toLowerCase(),sel=()=>platforms.find(p=>p.id===$('platform').value),name=()=>libraryRom?.file_name||localFile?.name||'',title=()=>libraryRom?.title||localFile?.name||'Nenhum jogo',key=()=>libraryRom?`rom-${libraryRom.id}`:localFile?`${localFile.name.toLowerCase().replace(/\.[^.]+$/,'').replace(/[^a-z0-9]+/g,'-')}-${localFile.size}`:'';function update(){const p=sel();$('gameTitle').textContent=title();$('gameMeta').textContent=(libraryRom||localFile)?`${p?.name||'Plataforma'} · ${libraryRom?'Minha Biblioteca':'Arquivo local'}`:'Aguardando seleção.';$('retro-platform').textContent=p?.short||'Plataforma —';$('play').disabled=!(libraryRom||localFile)||!p}async function end(){if(hb)clearInterval(hb),hb=null;const id=session;session=null;if(id)fetch(`/api/activity/${id}/end`,{method:'POST',keepalive:true}).catch(()=>{});$('retro-session').textContent='Nenhuma sessão ativa.'}async function startActivity(p){await end();try{const d=await api('/activity/start',{method:'POST',body:JSON.stringify({mode:'retro-wasm',game_key:key(),title:title(),platform_id:p.id})});session=d.session.id;$('retro-session').textContent=`${title()} · sessão sincronizada`;hb=setInterval(()=>fetch(`/api/activity/${session}/heartbeat`,{method:'POST'}).catch(()=>{}),30000)}catch{}}async function boot(){const pd=await api('/retro/platforms');platforms=pd.items||[];$('platform').innerHTML='<option value="">Detectar plataforma</option>'+platforms.map(p=>`<option value="${p.id}">${SC.esc(p.short)} · ${SC.esc(p.name)}</option>`).join('');const rid=new URLSearchParams(location.search).get('rom');if(rid){try{const d=await api('/library/roms');libraryRom=d.items.find(r=>r.id===rid);if(libraryRom)$('platform').value=libraryRom.platform_id}catch(e){SC.note('Entre na conta para abrir este jogo.','err')}}update()}$('rom').onchange=()=>{libraryRom=null;localFile=$('rom').files?.[0]||null;if(localFile){const m=platforms.filter(p=>p.extensions.includes(ext(localFile.name)));if(m.length===1)$('platform').value=m[0].id}update()};$('platform').onchange=update;$('play').onclick=async()=>{const p=sel();if(!p)return;try{await end();if(emulator)try{emulator.exit()}catch{};$('empty').style.display='none';const content=libraryRom?libraryRom.file_url:localFile;emulator=await Nostalgist.prepare({element:$('gameCanvas'),core:p.core,rom:{fileName:name(),fileContent:content},cache:{core:true,bios:true,shader:true},retroarchConfig:{rewind_enable:true,video_smooth:false}});await emulator.start();if(libraryRom)fetch(`/api/library/roms/${libraryRom.id}/played`,{method:'POST'}).catch(()=>{});startActivity(p);['resume','save','loadState','exportState','pause','exit'].forEach(id=>$(id).disabled=false);SC.note('Jogo em execução local.','ok')}catch(e){$('empty').style.display='grid';SC.note('Falha ao iniciar: '+e.message,'err')}};$('pause').onclick=()=>{try{emulator?.pause()}catch{}};$('resume').onclick=()=>{try{emulator?.resume()}catch{}};$('exit').onclick=async()=>{await end();try{emulator?.exit()}catch{}emulator=null;$('empty').style.display='grid';['resume','save','loadState','exportState','pause','exit'].forEach(id=>$(id).disabled=true)};async function blob(){const r=await emulator.saveState(),s=r?.state||r;return s instanceof Blob?s:new Blob([s])}$('save').onclick=async()=>{try{const b=await blob(),f=new FormData();f.append('file',b,title()+'.state');const r=await fetch(`/api/saves/${encodeURIComponent(key())}/auto`,{method:'POST',body:f});if(r.status===401){SC.note('Sem login: use Exportar State.');return}if(!r.ok)throw Error('HTTP '+r.status);SC.note('Cloud save sincronizado.','ok')}catch(e){SC.note(e.message,'err')}};$('loadState').onclick=async()=>{const r=await fetch(`/api/saves/${encodeURIComponent(key())}/auto`);if(r.ok)return emulator.loadState(await r.blob()).then(()=>SC.note('Cloud save carregado.','ok'));$('stateFile').click()};$('stateFile').onchange=async()=>{const f=$('stateFile').files?.[0];if(f&&emulator)await emulator.loadState(f)};$('exportState').onclick=async()=>{const b=await blob(),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=title()+'.state';a.click()};$('fullscreen').onclick=async()=>document.fullscreenElement?document.exitFullscreen():document.querySelector('.pixel-shell').requestFullscreen();addEventListener('pagehide',end);boot();</script><script src="/assets/spatial-nav.js"></script></body></html>
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud Play</title><link rel="stylesheet" href="/assets/pixel.css"></head><body><div class="pixel-shell"><div class="ambient plate-0"></div><div class="pixel-stage"><div class="pixel-plate plate-0"></div><a class="hot nav-brand" href="/" aria-label="StorCloud Play"></a><a class="hot nav-home" href="/" aria-label="Início"></a><a class="hot nav-games" href="/catalog/" aria-label="Jogos"></a><a class="hot nav-explore" href="/catalog/" aria-label="Explorar"></a><a class="hot nav-retro" href="/library/" aria-label="Retro"></a><a class="hot nav-pc" href="/pc/" aria-label="PC Local"></a><a class="hot nav-ach" href="/achievements/" aria-label="Conquistas"></a><a class="hot nav-search" href="/catalog/" aria-label="Buscar"></a><a class="hot nav-user" href="/account/" aria-label="Conta"></a><div class="live-user">Conta</div><section class="live-mask home-greeting"><div class="live-kicker">STORCLOUD · LOCAL FIRST GAMING</div><h1 id="greet">Bem-vindo de volta,<br><span>jogador!</span></h1><p>Grandes jogos, em qualquer lugar. Sua biblioteca, seus dispositivos, seus saves e conquistas em uma única central.</p></section><div id="home-status" class="home-status"><span class="status-pill">API…</span><span class="status-pill">WASM…</span><span class="status-pill">WebGPU · WebGL</span></div><a id="home-play" class="hot" style="left:87px;top:354px;width:190px;height:55px" href="/catalog/" aria-label="Jogar agora"></a><a class="hot" style="left:290px;top:354px;width:172px;height:55px" href="/catalog/" aria-label="Explorar"></a><a id="card0" class="hot home-card-hot home-card-0" href="/games/doom-wasm/" aria-label="Doom"></a><a id="card1" class="hot home-card-hot home-card-1" href="/library/" aria-label="Retro"></a><a id="card2" class="hot home-card-hot home-card-2" href="/pc/" aria-label="PC Local"></a><a id="card3" class="hot home-card-hot home-card-3" href="/catalog/" aria-label="Quake"></a></div></div><script src="/assets/pixel.js"></script><script>const {api,$}=SC;(async()=>{try{const me=await api('/auth/me');$('greet').innerHTML=`Bem-vindo de volta,<br><span>${SC.esc(me.user.username)}!</span>`}catch{}let online=false;try{const h=await fetch('/api/healthz',{cache:'no-store'});online=h.ok}catch{}$('home-status').innerHTML=`<span class="status-pill ${online?'ok':'bad'}">API · ${online?'online':'offline'}</span><span class="status-pill ${typeof WebAssembly==='object'?'ok':'bad'}">WASM · ${typeof WebAssembly==='object'?'pronto':'indisponível'}</span><span class="status-pill">${navigator.gpu?'WebGPU':'WebGL'} · local</span>`;try{const c=await api('/catalog');const ids=['doom-wasm','retro-library','pc-local-library','quake-wasm'];for(let i=0;i<4;i++){const g=c.items.find(x=>x.id===ids[i]);if(!g)continue;const route=(g.routes||[]).find(r=>r.launch_url);if(route)$('card'+i).href=route.launch_url}const first=c.items.find(x=>(x.routes||[]).some(r=>r.launch_url));if(first){const r=first.routes.find(x=>x.launch_url);$('home-play').href=r.launch_url}}catch{}})();</script><script src="/assets/spatial-nav.js"></script></body></html>
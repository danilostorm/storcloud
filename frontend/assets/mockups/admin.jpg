<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Conquistas</title><link rel="stylesheet" href="/assets/pixel.css"></head><body><div class="pixel-shell"><div class="ambient plate-5"></div><div class="pixel-stage"><div class="pixel-plate plate-5"></div><a class="hot nav-brand" href="/" aria-label="StorCloud Play"></a><a class="hot nav-home" href="/" aria-label="Início"></a><a class="hot nav-games" href="/catalog/" aria-label="Jogos"></a><a class="hot nav-explore" href="/catalog/" aria-label="Explorar"></a><a class="hot nav-retro" href="/library/" aria-label="Retro"></a><a class="hot nav-pc" href="/pc/" aria-label="PC Local"></a><a class="hot nav-ach" href="/achievements/" aria-label="Conquistas"></a><a class="hot nav-search" href="/catalog/" aria-label="Buscar"></a><a class="hot nav-user" href="/account/" aria-label="Conta"></a><div class="live-user">Conta</div><section class="live-mask ach-summary"><div class="live-kicker">RESUMO DE CONQUISTAS</div><div id="ach-stats" class="live-grid" style="grid-template-columns:repeat(4,1fr);margin-top:14px"></div></section><section class="live-mask ach-grid-region"><div class="live-row"><div><div class="live-kicker">CONQUISTAS DA SUA CONTA</div><div id="ach-status" class="live-sub">Carregando…</div></div></div><div id="ach-grid" class="live-grid ach-grid scroll" style="height:365px;margin-top:10px"></div></section></div></div><script src="/assets/pixel.js"></script><script>const {api,$,esc}=SC;(async()=>{try{const [d,a]=await Promise.all([api('/achievements'),api('/activity/summary')]);const pct=d.total?Math.round(d.unlocked/d.total*100):0;$('ach-stats').innerHTML=`<div class="stat"><b>${d.unlocked}</b><small>DESBLOQUEADAS</small></div><div class="stat"><b>${a.distinct_games||0}</b><small>JOGOS</small></div><div class="stat"><b>${pct}%</b><small>PROGRESSO</small></div><div class="stat"><b>${a.total_hours||0}h</b><small>TEMPO</small></div>`;$('ach-status').textContent=`${d.unlocked}/${d.total} conquistas desbloqueadas`;$('ach-grid').innerHTML=d.items.map(x=>`<article class="live-card ach-card ${x.unlocked?'':'locked'}"><div class="ach-icon">${esc(x.icon)}</div><h3>${esc(x.title)}</h3><p>${esc(x.description)}</p><div style="margin-top:8px;font-size:8px;color:${x.unlocked?'#31e6a1':'#76809d'}">${x.unlocked?'DESBLOQUEADA':'BLOQUEADA'}</div></article>`).join('')}catch(e){$('ach-status').textContent='Entre na sua conta para ver conquistas.';SC.note(e.message,'err')}})();</script><script src="/assets/spatial-nav.js"></script></body></html>
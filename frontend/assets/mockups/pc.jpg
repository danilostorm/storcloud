<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Retro Library</title><link rel="stylesheet" href="/assets/pixel.css"></head><body><div class="pixel-shell"><div class="ambient plate-2"></div><div class="pixel-stage"><div class="pixel-plate plate-2"></div><a class="hot nav-brand" href="/" aria-label="StorCloud Play"></a><a class="hot nav-home" href="/" aria-label="Início"></a><a class="hot nav-games" href="/catalog/" aria-label="Jogos"></a><a class="hot nav-explore" href="/catalog/" aria-label="Explorar"></a><a class="hot nav-retro" href="/library/" aria-label="Retro"></a><a class="hot nav-pc" href="/pc/" aria-label="PC Local"></a><a class="hot nav-ach" href="/achievements/" aria-label="Conquistas"></a><a class="hot nav-search" href="/catalog/" aria-label="Buscar"></a><a class="hot nav-user" href="/account/" aria-label="Conta"></a><div class="live-user">Conta</div><aside class="live-mask lib-side scroll"><div class="live-kicker">BIBLIOTECA RETRO</div><button class="live-btn primary" data-platform="">▦ Todos <span id="count-all" style="margin-left:auto">0</span></button><button id="fav" class="live-btn">★ Favoritos</button><button id="recent" class="live-btn">◷ Recentes</button><div id="platforms" style="margin-top:12px"></div><div style="margin-top:16px"><button id="scanAll" class="live-btn">✦ Scan global</button><button id="openUpload" class="live-btn">＋ Adicionar ROM</button></div></aside><section id="lib-hero" class="live-mask lib-hero"><img id="hero-art" class="hero-art hidden"><div class="lib-hero-content"><div class="live-kicker">SELECIONADO</div><h1 id="hero-title">Sua coleção Retro</h1><p id="hero-meta" class="live-sub">Escolha um jogo abaixo.</p><p id="hero-desc" class="live-sub" style="line-height:1.45"></p><div style="margin-top:14px"><a id="hero-play" class="live-btn primary" href="/retro/">▶ Jogar</a> <button id="hero-fav" class="live-btn">☆ Favoritar</button> <button id="hero-scan" class="live-btn">✦ Escanear capa</button></div></div></section><section class="live-mask lib-grid-region"><div class="lib-tools"><input id="search" class="live-input" placeholder="Buscar jogos..."><span id="lib-count" class="live-muted" style="margin-left:auto;font-size:9px"></span></div><div id="lib-grid" class="live-grid lib-grid scroll" style="height:326px"></div></section><section id="uploadBox" class="live-mask lib-upload"><div class="live-row"><select id="uploadPlatform" class="live-select" style="width:190px"><option value="">Plataforma</option></select><input id="uploadTitle" class="live-input" style="flex:1" placeholder="Título opcional"><input id="uploadFile" type="file" style="color:#aeb8d6;font-size:9px"><button id="doUpload" class="live-btn primary">Enviar</button><button id="closeUpload" class="live-btn">Fechar</button></div></section><input id="coverPicker" type="file" accept="image/png,image/jpeg,image/webp" hidden></div></div><script src="/assets/pixel.js"></script><script>const {api,$,esc}=SC;let roms=[],plats=[],filter='',fav=false,recent=false,selected=null,coverTarget=null;function pname(id){return plats.find(p=>p.id===id)?.short||id.toUpperCase()}function select(r){selected=r;$('hero-title').textContent=r?.title||'Sua coleção Retro';$('hero-meta').textContent=r?`${pname(r.platform_id)} · ${(r.size_bytes/1048576).toFixed(1)} MB`:'Escolha um jogo abaixo.';$('hero-desc').textContent=r?.last_played_at?'Última sessão: '+new Date(r.last_played_at).toLocaleString():'';$('hero-play').href=r?`/retro/?rom=${r.id}`:'/retro/';$('hero-fav').textContent=r?.favorite?'★ Favorito':'☆ Favoritar';const img=$('hero-art');if(r?.background_url){img.src=r.background_url;img.classList.remove('hidden')}else img.classList.add('hidden')}function render(){const q=$('search').value.toLowerCase();let list=roms.filter(r=>(!filter||r.platform_id===filter)&&(!fav||r.favorite)&&(!q||(r.title+' '+r.platform_id).toLowerCase().includes(q)));if(recent)list=[...list].sort((a,b)=>new Date(b.last_played_at||0)-new Date(a.last_played_at||0));$('lib-count').textContent=`${list.length} jogo(s)`;$('lib-grid').innerHTML=list.length?list.map(r=>`<article class="live-card" tabindex="0" data-rom="${r.id}"><div class="live-cover portrait">${r.cover_url?`<img src="${esc(r.cover_url)}">`:`<div style="position:absolute;inset:0;display:grid;place-items:center;font-weight:900">${esc(pname(r.platform_id))}</div>`}</div><div class="live-card-body"><h3>${esc(r.title)}</h3><p>${esc(pname(r.platform_id))}</p></div></article>`).join(''):'<div class="live-muted">Nenhum jogo neste filtro.</div>';document.querySelectorAll('[data-rom]').forEach(el=>{const r=roms.find(x=>x.id===el.dataset.rom);el.onclick=()=>select(r);el.ondblclick=()=>location.href=`/retro/?rom=${r.id}`;el.onmouseenter=()=>select(r);el.onfocus=()=>select(r)})}async function load(){const [pd,rd]=await Promise.all([api('/retro/platforms'),api('/library/roms')]);plats=pd.items||[];roms=rd.items||[];$('count-all').textContent=roms.length;$('platforms').innerHTML=plats.map(p=>`<button class="live-btn" data-p="${p.id}">${esc(p.short)} <span style="margin-left:auto">${roms.filter(r=>r.platform_id===p.id).length}</span></button>`).join('');$('uploadPlatform').innerHTML='<option value="">Plataforma</option>'+plats.map(p=>`<option value="${p.id}">${esc(p.short)} · ${esc(p.name)}</option>`).join('');document.querySelectorAll('[data-p]').forEach(b=>b.onclick=()=>{filter=b.dataset.p;fav=recent=false;render()});if(!selected&&roms[0])select(roms[0]);render()}document.querySelector('[data-platform]').onclick=()=>{filter='';fav=recent=false;render()};$('fav').onclick=()=>{filter='';fav=true;recent=false;render()};$('recent').onclick=()=>{filter='';fav=false;recent=true;render()};$('search').oninput=render;$('hero-play').onclick=e=>{if(!selected){e.preventDefault();SC.note('Escolha um jogo.','err')}};$('hero-fav').onclick=async()=>{if(!selected)return;await api(`/library/roms/${selected.id}/favorite?value=${!selected.favorite}`,{method:'PUT'});selected.favorite=!selected.favorite;await load()};$('hero-scan').onclick=async()=>{if(!selected)return;SC.note('Procurando capa…');const d=await api(`/library/roms/${selected.id}/scan`,{method:'POST'});SC.note(d.matched?'Capa encontrada.':'Nenhum match exato.',d.matched?'ok':'');await load()};$('scanAll').onclick=async()=>{const q=await api('/library/scan',{method:'POST'});let n=0;for(const r of q.items||[]){try{await api(`/library/roms/${r.id}/scan`,{method:'POST'});n++}catch{}}SC.note(`Scan concluído em ${n} jogo(s).`,'ok');await load()};$('openUpload').onclick=()=>$('uploadBox').classList.add('show');$('closeUpload').onclick=()=>$('uploadBox').classList.remove('show');$('doUpload').onclick=async()=>{const f=$('uploadFile').files?.[0],p=$('uploadPlatform').value;if(!f||!p)return SC.note('Escolha plataforma e ROM.','err');const form=new FormData();form.append('platform_id',p);form.append('title',$('uploadTitle').value);form.append('file',f,f.name);const r=await fetch('/api/library/roms',{method:'POST',body:form});let d={};try{d=await r.json()}catch{}if(!r.ok)return SC.note(SC.detail(d.detail)||'Falha no upload','err');$('uploadBox').classList.remove('show');SC.note('ROM adicionada.','ok');if(d.auto_scan_url)fetch(d.auto_scan_url,{method:'POST'}).catch(()=>{});await load()};(async()=>{try{await api('/auth/me');await load()}catch(e){SC.note('Entre na sua conta para usar a biblioteca.','err')}})();</script><script src="/assets/spatial-nav.js"></script></body></html>
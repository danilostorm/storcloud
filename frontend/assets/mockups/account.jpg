<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · PC Local</title><link rel="stylesheet" href="/assets/pixel.css"></head><body><div class="pixel-shell"><div class="ambient plate-4"></div><div class="pixel-stage"><div class="pixel-plate plate-4"></div><a class="hot nav-brand" href="/" aria-label="StorCloud Play"></a><a class="hot nav-home" href="/" aria-label="Início"></a><a class="hot nav-games" href="/catalog/" aria-label="Jogos"></a><a class="hot nav-explore" href="/catalog/" aria-label="Explorar"></a><a class="hot nav-retro" href="/library/" aria-label="Retro"></a><a class="hot nav-pc" href="/pc/" aria-label="PC Local"></a><a class="hot nav-ach" href="/achievements/" aria-label="Conquistas"></a><a class="hot nav-search" href="/catalog/" aria-label="Buscar"></a><a class="hot nav-user" href="/account/" aria-label="Conta"></a><div class="live-user">Conta</div><section class="live-mask pc-agent"><div class="live-kicker">STATUS DO AGENT</div><h2 id="pc-name" class="live-title" style="margin-top:10px">Procurando PC…</h2><div id="agent-status" class="live-sub">127.0.0.1:47831</div><div id="agent-stats" class="live-grid" style="grid-template-columns:1fr 1fr;margin-top:15px"></div><a class="live-btn" href="/account/" style="margin-top:12px">Gerenciar dispositivo</a></section><section class="live-mask pc-devices"><div class="live-kicker">DISPOSITIVOS PAREADOS</div><select id="device" class="live-select" style="width:100%;margin-top:9px"><option value="">Selecione o PC</option></select><div id="devices-info" class="live-muted" style="font-size:9px;margin-top:10px"></div><a class="live-btn" href="/account/" style="margin-top:12px">＋ Parear novo PC</a></section><section class="live-mask pc-games"><div class="live-row"><div><div class="live-kicker">JOGOS INSTALADOS</div><div class="live-sub">Allowlist do Local Agent</div></div></div><div id="pc-games-grid" class="live-grid pc-game-grid scroll" style="height:185px;margin-top:10px"></div></section><section class="live-mask pc-continue"><div class="live-kicker">CONTINUAR NO PC</div><div id="pc-continue-list" class="scroll" style="height:185px;margin-top:10px"></div></section></div></div><script src="/assets/pixel.js"></script><script>const {api,$,esc}=SC,agent='http://127.0.0.1:47831';let games=[],devices=[],logged=false,online=false;async function boot(){try{const [h,c,g]=await Promise.all([fetch(agent+'/health',{cache:'no-store'}).then(r=>{if(!r.ok)throw Error();return r.json()}),fetch(agent+'/capabilities',{cache:'no-store'}).then(r=>r.json()),fetch(agent+'/games',{cache:'no-store'}).then(r=>r.json())]);online=true;games=g.games||[];$('pc-name').textContent=h.name||'Meu PC Gamer';$('agent-status').textContent=`Local Agent v${h.version} · ${h.paired?'pareado':'não pareado'}`;$('agent-stats').innerHTML=`<div class="stat"><b>${esc(c.os)}</b><small>SISTEMA</small></div><div class="stat"><b>${esc(c.arch)}</b><small>ARQUITETURA</small></div><div class="stat"><b>${c.logical_cpus}</b><small>CPUs LÓGICAS</small></div><div class="stat"><b style="color:#31e6a1">ONLINE</b><small>STATUS</small></div>`}catch{$('pc-name').textContent='PC desconectado';$('agent-status').textContent='Abra o StorCloud Local Agent v0.3+'}try{const me=await api('/auth/me');logged=true;const d=await api('/devices');devices=d.items.filter(x=>!x.revoked);$('device').innerHTML='<option value="">Selecione o PC</option>'+devices.map(x=>`<option value="${x.id}">${esc(x.name)} · ${esc(x.os)}/${esc(x.arch)}</option>`).join('');if(devices.length===1)$('device').value=devices[0].id;$('devices-info').textContent=`${devices.length} dispositivo(s) ativo(s) · ${me.user.username}`;try{const c=await api('/activity/continue');$('pc-continue-list').innerHTML=(c.items||[]).filter(x=>x.mode==='local-native').slice(0,5).map(x=>`<div class="live-row" style="padding:8px;border-bottom:1px solid #fff1"><div style="flex:1"><b style="font-size:9px">${esc(x.title)}</b><div class="live-muted" style="font-size:8px">${esc(x.game_key)}</div></div></div>`).join('')||'<div class="live-muted">Nenhum jogo recente.</div>'}catch{}}catch{$('devices-info').textContent='Entre na conta para gerar tickets.'}render()}function render(){if(!online)return $('pc-games-grid').innerHTML='<div class="live-muted">Local Agent offline.</div>';if(!games.length)return $('pc-games-grid').innerHTML='<div class="live-muted">Nenhum jogo cadastrado na allowlist.</div>';$('pc-games-grid').innerHTML=games.map((g,i)=>`<article class="live-card"><div class="live-cover portrait" style="background:linear-gradient(145deg,#${['5f3b1a','35216b','732822','224061','593b17'][i%5]},#090d1c)"></div><div class="live-card-body"><h3>${esc(g.name)}</h3><button class="live-btn primary" onclick="launch('${esc(g.id)}')">▶ Jogar</button></div></article>`).join('')}window.launch=async id=>{if(!logged)return SC.note('Entre na sua conta.','err');const did=$('device').value;if(!did)return SC.note('Selecione o PC pareado.','err');try{const t=await api(`/devices/${did}/launch-ticket`,{method:'POST',body:JSON.stringify({game_id:id})});const r = await fetch(`${agent}/launch/${encodeURIComponent(id)}`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ticket:t.ticket})});if(!r.ok)throw Error(await r.text());const d=await r.json();SC.note(`Jogo iniciado · PID ${d.pid}`,'ok')}catch(e){SC.note('Falha: '+e.message,'err')}};boot();</script><script src="/assets/spatial-nav.js"></script></body></html>
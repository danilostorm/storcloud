<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StorCloud · Explorar</title><link rel="stylesheet" href="/assets/pixel.css"></head><body><div class="pixel-shell"><div class="ambient plate-1"></div><div class="pixel-stage"><div class="pixel-plate plate-1"></div><a class="hot nav-brand" href="/" aria-label="StorCloud Play"></a><a class="hot nav-home" href="/" aria-label="Início"></a><a class="hot nav-games" href="/catalog/" aria-label="Jogos"></a><a class="hot nav-explore" href="/catalog/" aria-label="Explorar"></a><a class="hot nav-retro" href="/library/" aria-label="Retro"></a><a class="hot nav-pc" href="/pc/" aria-label="PC Local"></a><a class="hot nav-ach" href="/achievements/" aria-label="Conquistas"></a><a class="hot nav-search" href="/catalog/" aria-label="Buscar"></a><a class="hot nav-user" href="/account/" aria-label="Conta"></a><div class="live-user">Conta</div><section id="feature" class="live-mask live-glass" style="left:707px;top:108px;width:897px;height:226px;padding:24px"><div class="live-kicker">DESTAQUE DO CATÁLOGO</div><h2 id="feature-title" style="font-size:30px;margin:11px 0 7px">Carregando…</h2><p id="feature-desc" class="live-muted" style="width:45%;font-size:11px;line-height:1.45"></p><a id="feature-play" class="live-btn primary" style="margin-top:12px" href="#">▶ Jogar agora</a></section><section class="live-mask catalog-live"><div class="catalog-toolbar"><button class="live-btn primary" data-filter="all">Todos</button><button class="live-btn" data-filter="wasm">WASM</button><button class="live-btn" data-filter="retro">Retro</button><button class="live-btn" data-filter="pc">PC Local</button><button class="live-btn" data-filter="ready">Prontos</button><input id="search" class="live-input" placeholder="Buscar jogos..."></div><div id="catalog-grid" class="live-grid catalog-grid scroll" style="height:342px"></div></section></div></div><script src="/assets/pixel.js"></script><script>const {api,$,esc}=SC;let games=[],decisions=new Map(),filter='all',caps={wasm:typeof WebAssembly==='object',webgpu:!!navigator.gpu,local_agent:false,remote_stream:false};async function detect(){try{caps.local_agent=(await fetch('http://127.0.0.1:47831/health',{cache:'no-store'})).ok}catch{}try{const s=await api('/streaming/status');caps.remote_stream=!!s.configured}catch{}}async function load(){await detect();const d=await api('/catalog');games=d.items||[];await Promise.all(games.map(async g=>{try{const r=await fetch(`/api/catalog/${encodeURIComponent(g.id)}/resolve`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(caps)});if(r.ok)decisions.set(g.id,(await r.json()).decision)}catch{}}));render();const g=games.find(g=>decisions.get(g.id))||games[0];if(g)feature(g)}function feature(g){const d=decisions.get(g.id);$('feature-title').textContent=g.title;$('feature-desc').textContent=g.description||'';$('feature-play').href=d?.launch_url||'#';$('feature-play').style.opacity=d?.launch_url?1:.5}function ok(g){const d=decisions.get(g.id);if(filter==='ready')return !!d;if(filter==='wasm')return g.routes?.some(r=>r.mode?.includes('wasm'));if(filter==='retro')return g.category==='retro';if(filter==='pc')return g.category==='pc';return true}function render(){const q=$('search').value.toLowerCase();const list=games.filter(g=>ok(g)&&(!q||(g.title+' '+(g.description||'')).toLowerCase().includes(q)));$('catalog-grid').innerHTML=list.map(g=>{const d=decisions.get(g.id);return `<article class="live-card" tabindex="0" data-id="${esc(g.id)}"><div class="live-cover"><div style="position:absolute;inset:0;background:radial-gradient(circle at 70% 30%,#7b38ff55,transparent 45%),linear-gradient(135deg,#132552,#301345)"></div><span class="live-badge">${esc((d?.mode||g.category||'PLAY').toUpperCase())}</span></div><div class="live-card-body"><h3>${esc(g.title)}</h3><p>${esc(g.description||'')}</p><div style="margin-top:8px"><a class="live-btn ${d?'primary':''}" href="${d?.launch_url||'#'}">${d?'▶ Jogar':'Sem rota disponível'}</a></div></div></article>`}).join('');document.querySelectorAll('[data-id]').forEach(el=>el.onmouseenter=()=>feature(games.find(g=>g.id===el.dataset.id)))}document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('primary',x===b));render()});$('search').oninput=render;load().catch(e=>SC.note('Falha no catálogo: '+e.message,'err'));</script><script src="/assets/spatial-nav.js"></script></body></html>
:root{--w:1672;--h:941;--ink:#f5f7ff;--muted:#9ca8c8;--purple:#7c4dff;--blue:#4f73ff;--green:#31e6a1;--red:#ff4772}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#02040c;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow:hidden}button,input,select{font:inherit}.pixel-shell{position:fixed;inset:0;overflow:hidden;background:#02040c}.pixel-stage{position:absolute;width:1672px;height:941px;left:50%;top:50%;transform-origin:center center}.pixel-plate{position:absolute;inset:0;background-image:url('/assets/mockups/storcloud-plates.avif');background-repeat:no-repeat;background-size:1672px 7528px;pointer-events:none;user-select:none}.plate-0{background-position:0 0}.plate-1{background-position:0 -941px}.plate-2{background-position:0 -1882px}.plate-3{background-position:0 -2823px}.plate-4{background-position:0 -3764px}.plate-5{background-position:0 -4705px}.plate-6{background-position:0 -5646px}.plate-7{background-position:0 -6587px}.ambient{position:absolute;inset:-8%;background-image:url('/assets/mockups/storcloud-plates.avif');background-size:1672px 7528px;background-repeat:no-repeat;filter:blur(45px) saturate(1.2);opacity:.24;transform:scale(1.1)}.hot{position:absolute;display:block;border-radius:10px;text-decoration:none;color:transparent;outline:none;z-index:20}.hot:focus-visible{outline:3px solid #65a6ff;outline-offset:2px;box-shadow:0 0 25px #653cff88}.nav-home{left:287px;top:16px;width:80px;height:46px}.nav-games{left:382px;top:16px;width:80px;height:46px}.nav-explore{left:473px;top:16px;width:93px;height:46px}.nav-retro{left:576px;top:16px;width:75px;height:46px}.nav-pc{left:661px;top:16px;width:101px;height:46px}.nav-ach{left:765px;top:16px;width:105px;height:46px}.nav-user{left:1340px;top:12px;width:270px;height:58px}.nav-search{left:1210px;top:15px;width:50px;height:50px}.nav-brand{left:34px;top:15px;width:220px;height:50px}.live-user{position:absolute;z-index:22;left:1402px;top:25px;width:145px;height:28px;display:flex;align-items:center;color:#f5f7ff;font-size:12px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none;background:#071020;border-radius:5px;padding:0 5px}.live-mask{position:absolute;z-index:10;border:1px solid rgba(124,100,255,.20);background:linear-gradient(145deg,rgba(4,8,24,.94),rgba(7,10,28,.90));box-shadow:0 15px 45px rgba(0,0,0,.35);border-radius:12px;color:#f6f7ff;overflow:hidden}.live-glass{backdrop-filter:blur(18px);background:linear-gradient(145deg,rgba(9,12,35,.84),rgba(4,7,20,.88))}.live-pad{padding:16px}.live-title{margin:0;font-size:20px;font-weight:850}.live-sub{margin:4px 0 0;color:#9ca8c8;font-size:11px}.live-kicker{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#8e84ff;font-weight:850}.live-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:34px;padding:0 14px;border:1px solid rgba(160,175,230,.26);border-radius:7px;background:rgba(11,16,39,.9);color:white;font-size:10px;font-weight:750;text-decoration:none;cursor:pointer}.live-btn.primary{background:linear-gradient(135deg,#5274ff,#8f2cff);box-shadow:0 0 20px rgba(92,58,255,.28)}.live-btn.danger{color:#ff879e;border-color:#ff4f6d55}.live-btn:disabled{opacity:.45;cursor:not-allowed}.live-input,.live-select{height:34px;border:1px solid rgba(146,160,215,.22);border-radius:7px;background:#060a19;color:#f4f6ff;padding:0 10px;font-size:10px;outline:none}.live-input:focus,.live-select:focus{border-color:#7c66ff;box-shadow:0 0 0 2px #694cff25}.live-grid{display:grid;gap:10px}.live-card{background:linear-gradient(145deg,rgba(10,15,38,.97),rgba(5,8,22,.98));border:1px solid rgba(117,134,193,.20);border-radius:10px;overflow:hidden;color:#f7f8ff;text-decoration:none;position:relative}.live-card:hover,.live-card:focus-within{border-color:#7a5fff;box-shadow:0 0 0 1px #7a5fff44,0 10px 28px #0008}.live-cover{position:relative;overflow:hidden;background:linear-gradient(135deg,#151d48,#482078);aspect-ratio:16/9}.live-cover.portrait{aspect-ratio:3/4}.live-cover img{width:100%;height:100%;object-fit:cover;display:block}.live-card-body{padding:9px}.live-card h3{margin:0 0 4px;font-size:11px}.live-card p{margin:0;color:#8995b4;font-size:8px;line-height:1.35}.live-badge{position:absolute;left:8px;bottom:7px;background:#050913d9;border:1px solid #ffffff1c;border-radius:4px;padding:3px 5px;font-size:7px;font-weight:900}.live-row{display:flex;align-items:center;gap:8px}.live-row+.live-row{margin-top:8px}.live-dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);flex:none}.live-muted{color:#8e99b8}.live-message{position:absolute;z-index:40;left:50%;bottom:68px;transform:translateX(-50%);min-width:320px;max-width:760px;padding:10px 14px;border:1px solid #7591db33;border-radius:8px;background:#030817e8;color:#d9e3ff;font-size:10px;text-align:center;opacity:0;pointer-events:none;transition:.2s}.live-message.show{opacity:1}.live-message.err{border-color:#ff536455;color:#ff9aa8}.live-message.ok{border-color:#3be7a055;color:#82f2bd}.scroll{overflow:auto;scrollbar-width:thin;scrollbar-color:#5d4ad0 #080b1d}.scroll::-webkit-scrollbar{width:6px;height:6px}.scroll::-webkit-scrollbar-thumb{background:#5d4ad0;border-radius:10px}.status-pill{font-size:8px;padding:4px 7px;border-radius:999px;background:#0b1227;border:1px solid #7f91c42b}.status-pill.ok{color:#5af0ad}.status-pill.bad{color:#ff7189}.stat{padding:9px 11px;border-radius:8px;background:#0a0e23;border:1px solid #6677b526}.stat b{display:block;font-size:18px}.stat small{color:#8f9ab7;font-size:7px;letter-spacing:.08em}.progress{height:5px;background:#171c34;border-radius:10px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,#465cff,#a12cff)}.table{width:100%;border-collapse:collapse;font-size:9px}.table th,.table td{text-align:left;padding:7px 8px;border-bottom:1px solid #ffffff0e}.table th{color:#75819e;font-size:7px;text-transform:uppercase;letter-spacing:.08em}.hidden{display:none!important}
/* Home */.home-greeting{left:78px;top:126px;width:610px;height:155px;border:0;border-radius:0;background:linear-gradient(90deg,#040716 0%,#05091a 76%,transparent 100%);box-shadow:none;padding:22px 12px}.home-greeting h1{font-size:56px;line-height:1.02;margin:0 0 13px;font-weight:900;letter-spacing:-.035em}.home-greeting h1 span{background:linear-gradient(90deg,#853cff,#4596ff);-webkit-background-clip:text;color:transparent}.home-greeting p{max-width:520px;font-size:13px;line-height:1.45;color:#b8c0d8;margin:0}.home-status{left:86px;top:427px;width:410px;height:30px;display:flex;gap:8px;align-items:center;border:0;background:#030611}.home-card-hot{top:556px;width:352px;height:288px}.home-card-0{left:86px}.home-card-1{left:449px}.home-card-2{left:811px}.home-card-3{left:1173px}
/* Catalog */.catalog-live{left:56px;top:445px;width:1561px;height:405px;padding:12px;background:#050817f4}.catalog-grid{grid-template-columns:repeat(4,1fr)}.catalog-card .live-cover{aspect-ratio:2.25/1}.catalog-toolbar{display:flex;gap:8px;margin-bottom:10px}.catalog-toolbar .live-input{margin-left:auto;width:280px}
/* Library */.lib-side{left:20px;top:112px;width:165px;height:735px;padding:11px}.lib-side button{width:100%;margin:3px 0;text-align:left}.lib-hero{left:200px;top:105px;width:1436px;height:350px;padding:18px 22px;background:linear-gradient(90deg,#080b20 0%,#080b20e8 38%,#080b2070 67%,#080b2020 100%)}.lib-hero .hero-art{position:absolute;right:0;top:0;width:62%;height:100%;object-fit:cover;opacity:.55;mask-image:linear-gradient(90deg,transparent,#000 25%)}.lib-hero-content{position:relative;z-index:2;width:43%;padding-top:42px}.lib-hero h1{font-size:28px;margin:7px 0}.lib-grid-region{left:200px;top:470px;width:1436px;height:380px;padding:12px;background:#050817f4}.lib-grid{grid-template-columns:repeat(7,1fr)}.lib-grid .live-card h3{font-size:9px}.lib-tools{display:flex;gap:7px;margin-bottom:9px}.lib-tools .live-input{width:270px}.lib-upload{position:absolute;z-index:50;left:465px;top:330px;width:650px;padding:14px;display:none}.lib-upload.show{display:block}
/* Retro */.retro-game{position:absolute;z-index:12;left:72px;top:169px;width:1194px;height:592px;background:#000;border:1px solid #5a69b33d;border-radius:8px;overflow:hidden}.retro-game canvas{width:100%!important;height:100%!important;display:block;object-fit:contain;background:#000}.retro-empty{position:absolute;inset:0;display:grid;place-items:center;color:#8190b3;font-size:13px;background:#02040b}.retro-menu{left:1304px;top:163px;width:327px;height:653px;padding:14px;background:#070b1cf4}.retro-menu h2{font-size:16px;margin:8px 0 5px}.retro-menu button,.retro-menu .live-btn{width:100%;margin:4px 0}.retro-menu .live-input,.retro-menu .live-select{width:100%;margin-top:5px}.retro-top-status{left:75px;top:90px;width:1185px;height:52px;padding:8px 12px;display:flex;align-items:center;gap:18px;background:#050918e8}.retro-bottom{left:74px;top:780px;width:1189px;height:70px;padding:8px;background:#050817e8}
/* PC */.pc-agent{left:1191px;top:98px;width:402px;height:380px;padding:15px;background:#070b1df2}.pc-devices{left:27px;top:600px;width:310px;height:245px;padding:12px;background:#050817f3}.pc-games{left:350px;top:600px;width:885px;height:245px;padding:12px;background:#050817f3}.pc-continue{left:1248px;top:600px;width:343px;height:245px;padding:12px;background:#050817f3}.pc-game-grid{grid-template-columns:repeat(5,1fr)}
/* Achievements */.ach-summary{left:1110px;top:85px;width:490px;height:200px;padding:14px;background:#070b1df1}.ach-grid-region{left:28px;top:425px;width:1572px;height:420px;padding:12px;background:#050817f3}.ach-grid{grid-template-columns:repeat(5,1fr)}.ach-card{padding:12px;min-height:112px}.ach-icon{font-size:27px}.ach-card.locked{opacity:.5}
/* Account */.account-profile{left:203px;top:115px;width:870px;height:175px;padding:16px;background:#070b1df2}.account-profile-grid{display:grid;grid-template-columns:1.2fr repeat(4,.55fr);gap:10px;align-items:center}.account-section{padding:13px;background:#050817f2}.account-info{left:30px;top:330px;width:500px;height:250px}.account-devices{left:546px;top:330px;width:500px;height:250px}.account-saves{left:1062px;top:330px;width:580px;height:250px}.account-library{left:30px;top:596px;width:500px;height:246px}.account-security{left:546px;top:596px;width:500px;height:246px}.account-admin{left:1062px;top:596px;width:580px;height:246px}.auth-modal{position:absolute;z-index:70;left:50%;top:50%;transform:translate(-50%,-50%);width:820px;padding:22px;background:#070b1df8;border:1px solid #7961ff55;border-radius:14px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:grid;gap:4px;margin-top:8px}.field label{font-size:8px;color:#8e99b8}.field .live-input{width:100%}
/* Admin */.admin-stats{left:26px;top:225px;width:1590px;height:116px;padding:12px;display:grid;grid-template-columns:repeat(6,1fr);gap:10px;background:#050817f2}.admin-services{left:27px;top:370px;width:420px;height:260px;padding:12px;background:#050817f2}.admin-activity{left:463px;top:370px;width:565px;height:260px;padding:12px;background:#050817f2}.admin-users{left:1043px;top:370px;width:573px;height:260px;padding:12px;background:#050817f2}.admin-storage{left:27px;top:646px;width:1001px;height:197px;padding:12px;background:#050817f2}.admin-actions{left:1043px;top:646px;width:573px;height:197px;padding:12px;background:#050817f2}
